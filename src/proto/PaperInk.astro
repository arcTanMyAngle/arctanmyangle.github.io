---
// Prototype A: "paper & ink". Light-first, editorial: ruled lists, a serif masthead, red-ink notes.
import ProtoShell from "./ProtoShell.astro";
import Doodle from "./Doodle.astro";
import { arcade, chess, githubUrl, hello, lab } from "./content";
---

<ProtoShell
  title="Prototype A · paper & ink"
  label="A · paper & ink"
  defaultTheme="light"
  otherHref="/proto/b/"
  otherLabel="See B (night zine) →"
>
  <header class="masthead wrap">
    <a class="wordmark" href="#main">arcTanMyAngle</a>
    <nav aria-label="Sections">
      <ul>
        <li><a href="#arcade">Arcade</a></li>
        <li><a href="#lab">Lab</a></li>
        <li><a href="#chess">Chess</a></li>
        <li><a href="#about">About</a></li>
      </ul>
    </nav>
  </header>

  <main id="main" class="wrap" tabindex="-1">
    <section class="hero" aria-labelledby="hero-title">
      <h1 id="hero-title">
        <span class="underlined">Hello<Doodle kind="squiggle" class="hero__squiggle draw" /></span>.
      </h1>
      <p class="hero__lede">{hello}</p>
      <div class="hero__cta">
        <a class="button" href="#arcade">Play Stacker</a>
        <span class="margin-note">
          <Doodle kind="arrow" class="margin-note__arrow" />
          start here
        </span>
      </div>
    </section>

    <Doodle kind="rule" class="rule" />

    <section id="arcade" class="shelf" aria-labelledby="arcade-title">
      <header class="shelf__head">
        <h2 id="arcade-title">Arcade</h2>
        <p class="shelf__count">{arcade.length} games</p>
      </header>
      <ul class="entries" role="list">
        {
          arcade.map((item) => (
            <li class="entry">
              <h3><a href={item.href}>{item.title}</a></h3>
              <p>{item.blurb}</p>
              <p class="entry__meta">{item.meta}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <Doodle kind="rule" class="rule" />

    <section id="lab" class="shelf" aria-labelledby="lab-title">
      <header class="shelf__head">
        <h2 id="lab-title">Lab</h2>
        <p class="shelf__count">things that might break</p>
      </header>
      <ul class="entries" role="list">
        {
          lab.map((item) => (
            <li class="entry">
              <p class="stamp">{item.meta}</p>
              <h3><a href={item.href}>{item.title}</a></h3>
              <p>{item.blurb}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <Doodle kind="rule" class="rule" />

    <section id="chess" class="shelf" aria-labelledby="chess-title">
      <header class="shelf__head">
        <h2 id="chess-title">Chess</h2>
        <p class="shelf__count">{chess.length} lines I play</p>
      </header>
      <ol class="lines" role="list">
        {
          chess.map((line) => (
            <li class="line">
              <a href="#chess" class="line__name">{line.name}</a>
              <span class="line__side">{line.side}</span>
              <code class="line__moves">{line.moves}</code>
            </li>
          ))
        }
      </ol>
    </section>
  </main>

  <footer id="about" class="colophon wrap">
    <Doodle kind="rule" class="rule" />
    <p>Made by arcTanMyAngle. Say hi on <a href={githubUrl}>GitHub</a>.</p>
    <p class="colophon__note">Tabs and Projects get a shelf once something passes the quality gate.</p>
  </footer>
</ProtoShell>

<style is:global>
  :root {
    --serif: ui-serif, Charter, "Iowan Old Style", Georgia, serif;
    --sans: system-ui, -apple-system, "Segoe UI", sans-serif;
    --mono: ui-monospace, "Cascadia Mono", Consolas, monospace;
    color-scheme: light;
    --bg: #f5f0e6;
    --surface: #fbf8f1;
    --ink: #1c1a17;
    --muted: #5c564c;
    --rule: #cfc5b2;
    --accent: #a8361b;
    --accent-2: #2b4c80;
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --bg: #1b1916;
    --surface: #24211d;
    --ink: #f1ebdf;
    --muted: #b3aa9a;
    --rule: #453f36;
    --accent: #f0896a;
    --accent-2: #9bb6e4;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 1.0625rem/1.6 var(--sans);
    -webkit-text-size-adjust: 100%;
  }
  a {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  a:hover {
    color: var(--accent);
  }
  :focus-visible {
    outline: 3px solid var(--accent-2);
    outline-offset: 3px;
    border-radius: 2px;
  }
  main:focus {
    outline: none;
  }
  .wrap {
    width: 100%;
    max-width: 68rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 3rem);
  }

  /* Masthead */
  .masthead {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    align-items: baseline;
    justify-content: space-between;
    padding-block: 1.5rem 0;
  }
  .wordmark {
    font: italic 600 1.375rem/1.2 var(--serif);
    text-decoration: none;
  }
  .masthead ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .masthead nav a {
    display: inline-block;
    padding-block: 0.25rem;
    min-height: 24px;
    text-decoration: none;
  }
  .masthead nav a:hover {
    text-decoration: underline;
  }

  /* Hero */
  .hero {
    padding-block: clamp(3rem, 10vw, 7rem) clamp(2.5rem, 7vw, 5rem);
  }
  .hero h1 {
    margin: 0;
    font: 500 clamp(3.5rem, 13vw, 8rem) / 0.95 var(--serif);
    letter-spacing: -0.02em;
  }
  .underlined {
    position: relative;
    display: inline-block;
  }
  .hero__squiggle {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.08em;
    width: 100%;
    height: 0.16em;
    color: var(--accent);
    stroke-width: 4px;
  }
  .hero__squiggle path {
    stroke-width: 4px;
  }
  .hero__lede {
    max-width: 32ch;
    margin: 1.75rem 0 0;
    font: 400 clamp(1.25rem, 2.6vw, 1.625rem) / 1.4 var(--serif);
    color: var(--ink);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: center;
    margin-top: 2.25rem;
  }
  .button {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0.75rem 1.5rem;
    background: var(--ink);
    color: var(--bg);
    font: 600 1.0625rem/1 var(--sans);
    text-decoration: none;
    border-radius: 3px;
    box-shadow: 3px 3px 0 var(--accent);
  }
  .button:hover {
    color: var(--bg);
    box-shadow: 1px 1px 0 var(--accent);
    transform: translate(2px, 2px);
  }
  .margin-note {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--accent);
    font: italic 1.125rem/1 var(--serif);
  }
  .margin-note__arrow {
    width: 3rem;
    height: 2rem;
    transform: scaleX(-1) rotate(-8deg);
  }
  .margin-note__arrow path {
    stroke-width: 2px;
  }

  /* Rules */
  .rule {
    display: block;
    width: 100%;
    height: 10px;
    color: var(--rule);
  }
  .rule path {
    stroke-width: 1.5px;
  }

  /* Shelves */
  .shelf {
    padding-block: clamp(2rem, 5vw, 3.5rem);
    scroll-margin-top: 1rem;
  }
  .shelf__head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.75rem;
  }
  .shelf__head h2 {
    margin: 0;
    font: 500 clamp(2rem, 5vw, 3rem) / 1 var(--serif);
    letter-spacing: -0.01em;
  }
  .shelf__count {
    margin: 0;
    color: var(--muted);
    font: italic 1.0625rem/1.3 var(--serif);
  }
  .entries {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 2rem clamp(2rem, 5vw, 4rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .entry {
    border-top: 2px solid var(--ink);
    padding-top: 1rem;
  }
  .entry h3 {
    margin: 0 0 0.375rem;
    font: 600 1.625rem/1.2 var(--serif);
  }
  .entry h3 a {
    text-decoration: none;
  }
  .entry h3 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
  .entry p {
    margin: 0;
    max-width: 44ch;
  }
  .entry__meta {
    margin-top: 0.625rem !important;
    color: var(--muted);
    font: 0.875rem/1.4 var(--mono);
  }
  .stamp {
    display: inline-block;
    margin: 0 0 0.5rem !important;
    padding: 0.125rem 0.5rem;
    border: 1.5px solid var(--accent-2);
    border-radius: 3px;
    color: var(--accent-2);
    font: 600 0.75rem/1.4 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transform: rotate(-2deg);
  }

  /* Chess lines */
  .lines {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .line {
    display: grid;
    grid-template-columns: minmax(10rem, 14rem) 4.5rem 1fr;
    gap: 0.25rem 1.25rem;
    align-items: baseline;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--rule);
  }
  .line__name {
    font: 600 1.1875rem/1.3 var(--serif);
    text-decoration: none;
  }
  .line__name:hover {
    text-decoration: underline;
  }
  .line__side {
    color: var(--muted);
    font: italic 0.9375rem/1.3 var(--serif);
  }
  .line__moves {
    font: 0.9375rem/1.5 var(--mono);
    color: var(--ink);
  }
  @media (max-width: 40rem) {
    .line {
      grid-template-columns: 1fr auto;
    }
    .line__moves {
      grid-column: 1 / -1;
    }
  }

  /* Footer */
  .colophon {
    padding-block: 1rem 3rem;
  }
  .colophon p {
    margin: 1.25rem 0 0;
    font: 1.125rem/1.5 var(--serif);
  }
  .colophon__note {
    color: var(--muted);
    font: 0.875rem/1.4 var(--mono) !important;
  }

  /* Motion: only when the init script says so. */
  :root[data-motion="full"] .button {
    transition:
      transform 120ms ease,
      box-shadow 120ms ease;
  }
  /* Drawn on left to right. A clip, not stroke-dashoffset: dashes don't follow non-scaling strokes. */
  :root[data-motion="full"] .draw {
    clip-path: inset(-50% 100% -50% -10%);
    animation: draw 700ms 200ms ease-out forwards;
  }
  @keyframes draw {
    to {
      clip-path: inset(-50% -10% -50% -10%);
    }
  }
</style>
