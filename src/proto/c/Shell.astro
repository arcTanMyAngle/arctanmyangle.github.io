---
// Prototype C document shell: tokens, base styles, header, footer, theme + motion init.
// Dev-only (see src/pages/proto/c/[...path].astro). Pages pass their section so the nav
// marks it and the page picks up that section's hue.
import Icon from "./Icon.astro";
import { githubUrl, href, nav, type Section } from "./site";
import "./board.css";

interface Props {
  title: string;
  description?: string;
  section: Section;
}

const { title, description = "Games, chess, guitar tabs, data experiments and a skate sim in progress.", section } =
  Astro.props;
const fullTitle = section === "home" ? "arcTanMyAngle" : `${title} · arcTanMyAngle`;
const storageKey = "proto-c-theme";
---

<!doctype html>
<html lang="en" data-theme="dark" data-motion="full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <script is:inline define:vars={{ storageKey }}>
      // Blocking, so the stored theme applies before first paint. Dark unless the visitor chose light.
      var root = document.documentElement;
      try {
        var saved = localStorage.getItem(storageKey);
        if (saved === "light" || saved === "dark") root.dataset.theme = saved;
      } catch (e) {}
      var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      root.dataset.motion = reduce ? "reduced" : "full";
    </script>
  </head>
  <body data-section={section}>
    <a class="skip" href="#main">Skip to content</a>
    <div class="glow" aria-hidden="true"></div>

    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href={href()} aria-label="arcTanMyAngle, home">
          <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
            <rect x="1" y="1" width="30" height="30" rx="9" class="brand__tile"></rect>
            <path d="M8 23h16" class="brand__ray"></path>
            <path d="M8 23 22 9" class="brand__ray"></path>
            <path d="M15 23a7 7 0 0 0-2-5" class="brand__arc"></path>
          </svg>
          <span class="brand__word">arcTanMyAngle</span>
        </a>

        <nav class="site-nav" id="site-nav" aria-label="Main">
          <ul role="list">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={href(item.path)}
                    data-hue={item.section}
                    aria-current={item.section === section ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="site-header__actions">
          <button type="button" class="icon-btn" data-theme-toggle aria-label="Switch to light theme">
            <Icon name="sun" class="only-dark" />
            <Icon name="moon" class="only-light" />
          </button>
          <a class="icon-btn" href={githubUrl} aria-label="arcTanMyAngle on GitHub">
            <Icon name="github" />
          </a>
          <button
            type="button"
            class="icon-btn menu-btn"
            aria-controls="site-nav"
            aria-expanded="false"
            aria-label="Open menu"
            data-menu-toggle
          >
            <Icon name="menu" class="menu-btn__open" />
            <Icon name="close" class="menu-btn__close" />
          </button>
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <div class="site-footer__brand">
          <a class="brand" href={href()}>
            <span class="brand__word">arcTanMyAngle</span>
          </a>
          <p>Games, chess, guitar, skateboarding and code. Built by hand, no tracking.</p>
        </div>
        <nav class="site-footer__cols" aria-label="Footer">
          <div>
            <h2>Play</h2>
            <ul role="list">
              <li><a href={href("arcade/stacker")}>Stacker</a></li>
              <li><a href={href("arcade/reaction")}>Reaction</a></li>
              <li><a href={href("chess/play")}>Chess for two</a></li>
            </ul>
          </div>
          <div>
            <h2>Explore</h2>
            <ul role="list">
              <li><a href={href("chess")}>Chess lines</a></li>
              <li><a href={href("lab")}>Lab</a></li>
              <li><a href={href("tabs")}>Tabs</a></li>
              <li><a href={href("skate")}>Skate sim</a></li>
            </ul>
          </div>
          <div>
            <h2>More</h2>
            <ul role="list">
              <li><a href={href("projects")}>Projects</a></li>
              <li><a href={href("about")}>About</a></li>
              <li><a href={githubUrl}>GitHub</a></li>
            </ul>
          </div>
        </nav>
      </div>
      <div class="wrap site-footer__base">
        <span>Prototype C · dev-only, not deployed</span>
        <span>System fonts · no trackers</span>
      </div>
    </footer>

    <script>
      const root = document.documentElement;

      // Theme toggle.
      const themeButton = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
      const syncThemeLabel = () => {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        themeButton?.setAttribute("aria-label", `Switch to ${next} theme`);
      };
      syncThemeLabel();
      themeButton?.addEventListener("click", () => {
        root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark";
        syncThemeLabel();
        try {
          localStorage.setItem("proto-c-theme", root.dataset.theme);
        } catch {
          // Blocked storage: the toggle still works for this page view.
        }
      });

      // Mobile menu.
      const menuButton = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
      const setMenu = (open: boolean) => {
        menuButton?.setAttribute("aria-expanded", String(open));
        menuButton?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
        document.body.classList.toggle("menu-open", open);
      };
      menuButton?.addEventListener("click", () => setMenu(menuButton.getAttribute("aria-expanded") !== "true"));
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && document.body.classList.contains("menu-open")) {
          setMenu(false);
          menuButton?.focus();
        }
      });
      window.matchMedia("(min-width: 52.01rem)").addEventListener("change", (e) => e.matches && setMenu(false));

      // Pointer spotlight on interactive cards. One delegated listener; CSS only shows it under full motion.
      document.addEventListener(
        "pointermove",
        (e) => {
          if (e.pointerType !== "mouse") return;
          const card = (e.target as Element | null)?.closest<HTMLElement>("[data-spotlight]");
          if (!card) return;
          const r = card.getBoundingClientRect();
          card.style.setProperty("--mx", `${e.clientX - r.left}px`);
          card.style.setProperty("--my", `${e.clientY - r.top}px`);
        },
        { passive: true }
      );
    </script>
  </body>
</html>

<style is:global>
  /* ---------- Tokens ---------- */
  :root {
    --sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
    --mono: ui-monospace, "SF Mono", "Cascadia Mono", Consolas, monospace;
    --radius-s: 8px;
    --radius: 14px;
    --radius-l: 22px;
    --wrap: 76rem;
    --gutter: clamp(1rem, 4vw, 2.5rem);
    --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
    --header-h: 4rem;
  }
  :root,
  :root[data-theme="dark"] {
    color-scheme: dark;
    --bg: #09090b;
    --surface: #131418;
    --surface-2: #1a1c21;
    --surface-3: #23252c;
    --line: #25272e;
    --line-2: #363943;
    --text: #ededf0;
    --text-2: #a5a8b2;
    --text-3: #8a8e99;
    --on-solid: #09090b;
    --solid: #ededf0;
    --shadow: 0 1px 0 rgb(255 255 255 / 0.04) inset, 0 20px 40px -24px rgb(0 0 0 / 0.8);
    --arcade: #ff8a65;
    --chess: #f6c453;
    --lab: #4dd4c6;
    --tabs: #b69cff;
    --skate: #a8e05f;
    --projects: #6aa8ff;
    --about: #ff8fc7;
    --board-light: #e9e4d8;
    --board-dark: #8495b0;
  }
  :root[data-theme="light"] {
    color-scheme: light;
    --bg: #f7f7f8;
    --surface: #ffffff;
    --surface-2: #f2f2f4;
    --surface-3: #e7e7ea;
    --line: #e2e2e6;
    --line-2: #cfd0d6;
    --text: #0b0b0f;
    --text-2: #4b4e57;
    --text-3: #5f626b;
    --on-solid: #ffffff;
    --solid: #0b0b0f;
    --shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 16px 32px -20px rgb(0 0 0 / 0.18);
    --arcade: #c2410c;
    --chess: #9a5800;
    --lab: #0f766e;
    --tabs: #6d4ad6;
    --skate: #4d7c0f;
    --projects: #1d5fd1;
    --about: #be185d;
    --board-light: #efe9dc;
    --board-dark: #7d8eaa;
  }

  /* Each section (and any element with data-hue) gets its own accent. */
  :root {
    --hue: var(--text);
  }
  [data-section="arcade"],
  [data-hue="arcade"] {
    --hue: var(--arcade);
  }
  [data-section="chess"],
  [data-hue="chess"] {
    --hue: var(--chess);
  }
  [data-section="lab"],
  [data-hue="lab"] {
    --hue: var(--lab);
  }
  [data-section="tabs"],
  [data-hue="tabs"] {
    --hue: var(--tabs);
  }
  [data-section="skate"],
  [data-hue="skate"] {
    --hue: var(--skate);
  }
  [data-section="projects"],
  [data-hue="projects"] {
    --hue: var(--projects);
  }
  [data-section="about"],
  [data-hue="about"] {
    --hue: var(--about);
  }
  [data-section="home"] {
    --hue: var(--projects);
  }
  :root {
    --hue-soft: color-mix(in oklab, var(--hue) 14%, transparent);
    --hue-line: color-mix(in oklab, var(--hue) 40%, var(--line));
  }
  [data-section],
  [data-hue] {
    --hue-soft: color-mix(in oklab, var(--hue) 14%, transparent);
    --hue-line: color-mix(in oklab, var(--hue) 40%, var(--line));
  }

  /* ---------- Base ---------- */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
    scroll-padding-top: calc(var(--header-h) + 1rem);
  }
  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    color: var(--text);
    font: 400 1rem/1.6 var(--sans);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  main {
    flex: 1;
    position: relative;
    z-index: 1;
  }
  main:focus {
    outline: none;
  }
  h1,
  h2,
  h3,
  h4 {
    margin: 0;
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.15;
    text-wrap: balance;
  }
  p {
    margin: 0;
    text-wrap: pretty;
  }
  a {
    color: inherit;
  }
  img,
  svg {
    display: block;
  }
  button {
    font: inherit;
    color: inherit;
  }
  :focus-visible {
    outline: 2px solid var(--hue);
    outline-offset: 3px;
    border-radius: 6px;
  }
  ::selection {
    background: color-mix(in oklab, var(--hue) 35%, transparent);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .wrap {
    width: 100%;
    max-width: calc(var(--wrap) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .skip {
    position: absolute;
    left: 1rem;
    top: -10rem;
    z-index: 100;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-s);
    background: var(--solid);
    color: var(--on-solid);
    font-weight: 600;
    text-decoration: none;
  }
  .skip:focus {
    top: 1rem;
  }
  /* A soft wash of the section hue at the top of every page. Decoration only. */
  .glow {
    position: absolute;
    inset: 0 0 auto;
    height: 40rem;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(60rem 26rem at 50% -8rem, color-mix(in oklab, var(--hue) 16%, transparent), transparent 70%),
      radial-gradient(circle at 1px 1px, color-mix(in oklab, var(--text) 9%, transparent) 1px, transparent 0) 0 0 / 24px
        24px;
    mask-image: linear-gradient(to bottom, #000 0%, transparent 100%);
  }

  /* ---------- Header ---------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: color-mix(in oklab, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: var(--header-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    font-weight: 650;
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }
  .brand__mark {
    width: 30px;
    height: 30px;
  }
  .brand__tile {
    fill: var(--surface-2);
    stroke: var(--line-2);
  }
  .brand__ray {
    stroke: var(--text);
    stroke-width: 2.25;
    stroke-linecap: round;
    fill: none;
  }
  .brand__arc {
    stroke: var(--hue);
    stroke-width: 2.25;
    stroke-linecap: round;
    fill: none;
  }
  .site-nav ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 0.75rem;
    border-radius: 999px;
    color: var(--text-2);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }
  .site-nav a:hover {
    color: var(--text);
    background: var(--surface-2);
  }
  .site-nav a[aria-current="page"] {
    color: var(--text);
    background: var(--surface-2);
  }
  .site-nav a[aria-current="page"]::before {
    content: "";
    width: 6px;
    height: 6px;
    margin-right: 0.5rem;
    border-radius: 50%;
    background: var(--hue);
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
  }
  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--text-2);
    cursor: pointer;
    text-decoration: none;
  }
  .icon-btn:hover {
    color: var(--text);
    background: var(--surface-2);
    border-color: var(--line);
  }
  :root[data-theme="dark"] .only-light,
  :root[data-theme="light"] .only-dark {
    display: none;
  }
  .menu-btn {
    display: none;
  }
  .menu-btn__close,
  .menu-open .menu-btn__open {
    display: none;
  }
  .menu-open .menu-btn__close {
    display: block;
  }
  @media (max-width: 52rem) {
    .menu-btn {
      display: inline-grid;
    }
    .site-nav {
      display: none;
      position: absolute;
      top: var(--header-h);
      left: 0;
      right: 0;
      padding: 0.75rem var(--gutter) 1.25rem;
      border-bottom: 1px solid var(--line);
      background: var(--bg);
    }
    .menu-open .site-nav {
      display: block;
    }
    .site-nav ul {
      flex-direction: column;
    }
    .site-nav a {
      width: 100%;
      min-height: 3rem;
      font-size: 1.0625rem;
      border-radius: var(--radius-s);
    }
  }

  /* ---------- Footer ---------- */
  .site-footer {
    position: relative;
    z-index: 1;
    margin-top: clamp(4rem, 10vw, 7rem);
    border-top: 1px solid var(--line);
    background: var(--surface);
  }
  .site-footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 2fr);
    gap: 2.5rem;
    padding-block: 3rem 2rem;
  }
  .site-footer__brand p {
    max-width: 30ch;
    margin-top: 0.75rem;
    color: var(--text-2);
    font-size: 0.9375rem;
  }
  .site-footer__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .site-footer h2 {
    margin-bottom: 0.75rem;
    color: var(--text-3);
    font: 600 0.75rem/1.4 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .site-footer ul {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer li a {
    display: inline-block;
    padding-block: 0.25rem;
    color: var(--text-2);
    font-size: 0.9375rem;
    text-decoration: none;
  }
  .site-footer li a:hover {
    color: var(--text);
  }
  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1.25rem 2rem;
    border-top: 1px solid var(--line);
    color: var(--text-3);
    font: 0.8125rem/1.4 var(--mono);
  }
  @media (max-width: 40rem) {
    .site-footer__inner {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Shared components ---------- */
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--hue);
    font: 600 0.75rem/1.4 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .eyebrow::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }
  .page-head {
    padding-block: clamp(3rem, 8vw, 5.5rem) clamp(2rem, 5vw, 3rem);
  }
  .page-head h1 {
    margin-top: 1rem;
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    letter-spacing: -0.04em;
    line-height: 1.02;
  }
  .page-head .lede {
    max-width: 52ch;
    margin-top: 1.25rem;
    color: var(--text-2);
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.55;
  }
  .page-head .actions {
    margin-top: 2rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1.125rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--text);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
  }
  .btn:hover {
    border-color: var(--text-3);
    background: var(--surface-3);
  }
  .btn--primary {
    border-color: var(--solid);
    background: var(--solid);
    color: var(--on-solid);
  }
  .btn--primary:hover {
    border-color: var(--solid);
    background: color-mix(in oklab, var(--solid) 86%, var(--hue));
  }
  .btn--quiet {
    border-color: transparent;
    background: transparent;
    color: var(--text-2);
  }
  .btn--quiet:hover {
    background: var(--surface-2);
    border-color: var(--line);
    color: var(--text);
  }
  .btn--small {
    min-height: 2.25rem;
    padding: 0 0.875rem;
    font-size: 0.875rem;
  }
  .btn .icon {
    flex-shrink: 0;
  }
  .btn[disabled] {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.1875rem 0.625rem;
    border: 1px solid var(--hue-line);
    border-radius: 999px;
    background: var(--hue-soft);
    color: var(--text);
    font: 600 0.75rem/1.4 var(--mono);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .badge--muted {
    border-color: var(--line);
    background: var(--surface-2);
    color: var(--text-2);
  }
  .kbd {
    display: inline-block;
    min-width: 1.5em;
    padding: 0.0625rem 0.4375rem;
    border: 1px solid var(--line-2);
    border-bottom-width: 2px;
    border-radius: 6px;
    background: var(--surface-2);
    font: 600 0.8125rem/1.4 var(--mono);
    text-align: center;
  }
  .card {
    position: relative;
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  a.card {
    display: block;
    text-decoration: none;
  }
  a.card:hover,
  .card--link:hover {
    border-color: var(--hue-line);
  }
  /* The whole-card link pattern: one real link, stretched over the card. */
  .card__link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
  }
  .card__link {
    text-decoration: none;
  }
  .card__link:focus-visible {
    outline: none;
  }
  .card:has(.card__link:focus-visible) {
    outline: 2px solid var(--hue);
