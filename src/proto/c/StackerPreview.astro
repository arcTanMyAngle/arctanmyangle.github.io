---
// Decorative Stacker loop: a few placed rows and one row sliding in steps above them.
// Pure CSS, still under reduced motion. Used on the home tile and the arcade index.
const stack = [
  [2, 5],
  [2, 5],
  [2, 4],
  [3, 4],
];
---

<div class="stackmini" aria-hidden="true">
  <div class="stackmini__grid">
    <span class="stackmini__mover"></span>
    {stack.map(([from, to], row) => <span class="stackmini__row" style={`--row:${row};--from:${from};--len:${to - from}`} />)}
  </div>
</div>

<style>
  .stackmini {
    flex: 1;
    display: grid;
    place-items: end center;
    margin-top: 1.5rem;
  }
  .stackmini__grid {
    --cell: clamp(1.5rem, 4.2vw, 2.25rem);
    position: relative;
    width: calc(var(--cell) * 7);
    height: calc(var(--cell) * 6);
    border-bottom: 2px solid var(--line-2);
    background:
      linear-gradient(to right, var(--line) 1px, transparent 1px) 0 0 / var(--cell) var(--cell),
      linear-gradient(to bottom, var(--line) 1px, transparent 1px) 0 0 / var(--cell) var(--cell);
  }
  .stackmini__row,
  .stackmini__mover {
    position: absolute;
    height: var(--cell);
    padding: 3px;
    background-clip: content-box;
    border-radius: 7px;
    background-image: repeating-linear-gradient(
      to right,
      transparent 0 calc(var(--cell) - 6px),
      var(--surface) calc(var(--cell) - 6px) var(--cell)
    );
  }
  .stackmini__row {
    left: calc(var(--from) * var(--cell));
    bottom: calc(var(--row) * var(--cell));
    width: calc(var(--len) * var(--cell));
    background-color: color-mix(in oklab, var(--hue) 55%, var(--surface-3));
  }
  .stackmini__mover {
    left: 0;
    bottom: calc(4 * var(--cell));
    width: calc(2 * var(--cell));
    background-color: var(--hue);
    transform: translateX(calc(3 * var(--cell)));
    box-shadow: 0 0 24px -4px var(--hue);
  }
  :global(:root[data-motion="full"]) .stackmini__mover {
    animation: slide 2.6s steps(5, jump-none) infinite alternate;
  }
  @keyframes slide {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(5 * var(--cell)));
    }
  }
</style>
