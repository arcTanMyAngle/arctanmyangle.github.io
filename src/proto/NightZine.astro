---
// Prototype B: "night zine". Dark-first, cut-and-paste: numbered sections, taped cards,
// a highlighter pass on the headline and coral stickers on experiments.
import ProtoShell from "./ProtoShell.astro";
import Doodle from "./Doodle.astro";
import { arcade, chess, githubUrl, hello, lab } from "./content";
---

<ProtoShell
  title="Prototype B · night zine"
  label="B · night zine"
  defaultTheme="dark"
  otherHref="/proto/a/"
  otherLabel="See A (paper & ink) →"
>
  <header class="top wrap">
    <a class="wordmark" href="#main">
      <Doodle kind="star" class="wordmark__star" />
      arcTanMyAngle
    </a>
    <nav aria-label="Sections">
      <ul>
        <li><a href="#arcade">Arcade</a></li>
        <li><a href="#lab">Lab</a></li>
        <li><a href="#chess">Chess</a></li>
        <li><a href="#about">About</a></li>
      </ul>
    </nav>
  </header>

  <main id="main" class="wrap" tabindex="-1">
    <section class="hero" aria-labelledby="hero-title">
      <Doodle kind="star" class="hero__star hero__star--a" />
      <Doodle kind="star" class="hero__star hero__star--b" />
      <h1 id="hero-title">
        <span class="marked"><Doodle kind="marker" class="marked__swipe draw" /><span>Hello.</span></span>
      </h1>
      <p class="hero__lede">{hello}</p>
      <a class="button" href="#arcade">Play Stacker</a>
    </section>

    <section id="arcade" class="shelf" aria-labelledby="arcade-title">
      <h2 id="arcade-title" class="shelf__title"><span class="shelf__num" aria-hidden="true">01</span>Arcade</h2>
      <ul class="cards" role="list">
        {
          arcade.map((item) => (
            <li class="card">
              <h3><a href={item.href}>{item.title}</a></h3>
              <p>{item.blurb}</p>
              <p class="card__meta">{item.meta}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="lab" class="shelf" aria-labelledby="lab-title">
      <h2 id="lab-title" class="shelf__title"><span class="shelf__num" aria-hidden="true">02</span>Lab</h2>
      <ul class="cards" role="list">
        {
          lab.map((item) => (
            <li class="card card--lab">
              <p class="sticker">{item.meta}</p>
              <h3><a href={item.href}>{item.title}</a></h3>
              <p>{item.blurb}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="chess" class="shelf" aria-labelledby="chess-title">
      <h2 id="chess-title" class="shelf__title"><span class="shelf__num" aria-hidden="true">03</span>Chess</h2>
      <ol class="setlist" role="list">
        {
          chess.map((line) => (
            <li class="set">
              <a href="#chess" class="set__name">{line.name}</a>
              <span class="set__side">{line.side}</span>
              <span class="set__leader" aria-hidden="true" />
              <code class="set__moves">{line.moves}</code>
            </li>
          ))
        }
      </ol>
    </section>
  </main>

  <footer id="about" class="back wrap">
    <Doodle kind="squiggle" class="back__squiggle" />
    <p>Made after dark by arcTanMyAngle. Code's on <a href={githubUrl}>GitHub</a>.</p>
    <p class="back__note">Tabs and Projects get a page once something passes the quality gate.</p>
  </footer>
</ProtoShell>

<style is:global>
  :root {
    --serif: ui-serif, Charter, "Iowan Old Style", Georgia, serif;
    --sans: system-ui, -apple-system, "Segoe UI", sans-serif;
    --mono: ui-monospace, "Cascadia Mono", Consolas, monospace;
    color-scheme: dark;
    --bg: #111318;
    --surface: #1a1d24;
    --ink: #ece6d8;
    --muted: #a49d8f;
    --rule: #2c303a;
    --edge: #4a4f5c;
    --accent: #ffd34d;
    --accent-2: #ff8a6b;
    --hl: #ffd34d;
    --on-hl: #111318;
    --sticker: #ff8a6b;
    --on-sticker: #111318;
    --tape: rgb(255 211 77 / 0.22);
  }
  :root[data-theme="light"] {
    color-scheme: light;
    --bg: #ebe6da;
    --surface: #f7f3ea;
    --ink: #15171c;
    --muted: #555047;
    --rule: #cfc8b8;
    --edge: #15171c;
    --accent: #755800;
    --accent-2: #b03d1d;
    --hl: #ffd34d;
    --on-hl: #15171c;
    --sticker: #b03d1d;
    --on-sticker: #f7f3ea;
    --tape: rgb(117 88 0 / 0.18);
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 1.0625rem/1.6 var(--sans);
    -webkit-text-size-adjust: 100%;
    overflow-x: clip;
  }
  a {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  a:hover {
    color: var(--accent);
  }
  :focus-visible {
    outline: 3px solid var(--accent-2);
    outline-offset: 3px;
    border-radius: 2px;
  }
  main:focus {
    outline: none;
  }
  .wrap {
    width: 100%;
    max-width: 70rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 3rem);
  }

  /* Top bar */
  .top {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.25rem 0;
  }
  .wordmark {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    font: 700 1rem/1 var(--mono);
    letter-spacing: 0.02em;
    text-decoration: none;
  }
  .wordmark__star {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--accent);
  }
  .wordmark__star path {
    stroke-width: 2px;
  }
  .top ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .top nav a {
    display: inline-block;
    padding-block: 0.25rem;
    min-height: 24px;
    font: 0.8125rem/1.4 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .top nav a:hover {
    text-decoration: underline;
  }

  /* Hero */
  .hero {
    position: relative;
    padding-block: clamp(3.5rem, 11vw, 8rem) clamp(3rem, 8vw, 6rem);
  }
  .hero h1 {
    margin: 0;
    font: 700 clamp(4rem, 16vw, 10rem) / 0.95 var(--serif);
    letter-spacing: -0.03em;
  }
  .marked {
    position: relative;
    display: inline-block;
    color: var(--on-hl);
  }
  .marked > span {
    position: relative;
  }
  .marked__swipe {
    position: absolute;
    inset: -0.05em -0.12em;
    width: calc(100% + 0.24em);
    height: calc(100% + 0.1em);
    color: var(--hl);
    overflow: visible;
    transform: rotate(-1.5deg);
  }
  .hero__lede {
    max-width: 30ch;
    margin: 2rem 0 0;
    font: 400 clamp(1.25rem, 2.8vw, 1.75rem) / 1.35 var(--serif);
  }
  .hero__star {
    position: absolute;
    color: var(--accent-2);
  }
  .hero__star path {
    stroke-width: 2px;
  }
  .hero__star--a {
    top: clamp(1.5rem, 5vw, 3.5rem);
    right: 12%;
    width: 2.5rem;
    height: 2.5rem;
    transform: rotate(14deg);
  }
  .hero__star--b {
    bottom: clamp(2rem, 6vw, 4rem);
    right: 26%;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--accent);
    transform: rotate(-10deg);
  }
  .button {
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    margin-top: 2.25rem;
    padding: 0.875rem 1.75rem;
    background: var(--hl);
    color: var(--on-hl);
    font: 700 1.125rem/1 var(--sans);
    text-decoration: none;
    border: 2px solid var(--on-hl);
    border-radius: 4px;
    transform: rotate(-1.5deg);
  }
  .button:hover {
    color: var(--on-hl);
    transform: rotate(0deg);
  }

  /* Shelves */
  .shelf {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    border-top: 1px dashed var(--edge);
    scroll-margin-top: 1rem;
  }
  .shelf__title {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    margin: 0 0 2rem;
    font: 700 clamp(2.25rem, 6vw, 3.5rem) / 1 var(--serif);
    letter-spacing: -0.02em;
  }
  .shelf__num {
    color: var(--accent);
    font: 500 1rem/1 var(--mono);
    letter-spacing: 0.1em;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    position: relative;
    padding: 1.75rem 1.5rem 1.5rem;
    background: var(--surface);
    border: 1.5px solid var(--edge);
    border-radius: 2px;
  }
  .card:nth-child(odd) {
    transform: rotate(-0.6deg);
  }
  .card:nth-child(even) {
    transform: rotate(0.5deg);
  }
  /* A strip of flat, see-through tape across the top corner. */
  .card::before {
    content: "";
    position: absolute;
    top: -0.7rem;
    left: 1.25rem;
    width: 5.5rem;
    height: 1.4rem;
    background: var(--tape);
    transform: rotate(-4deg);
  }
  .card h3 {
    margin: 0 0 0.5rem;
    font: 700 1.75rem/1.15 var(--serif);
  }
  .card h3 a {
    text-decoration: none;
  }
  .card h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .card:hover h3 a {
    color: var(--accent);
  }
  .card:has(a:focus-visible) {
    outline: 3px solid var(--accent-2);
    outline-offset: 3px;
  }
  .card h3 a:focus-visible {
    outline: none;
  }
  .card p {
    margin: 0;
    max-width: 44ch;
  }
  .card__meta {
    margin-top: 1rem !important;
    color: var(--muted);
    font: 0.8125rem/1.4 var(--mono);
    letter-spacing: 0.04em;
  }
  .sticker {
    position: absolute;
    top: -0.85rem;
    right: 1rem;
    margin: 0 !important;
    padding: 0.25rem 0.625rem;
    background: var(--sticker);
    color: var(--on-sticker);
    font: 700 0.75rem/1.4 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 2px;
    transform: rotate(4deg);
  }

  /* Chess setlist */
  .setlist {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: set;
  }
  .set {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: baseline;
    padding-block: 0.875rem;
    border-bottom: 1px solid var(--rule);
    counter-increment: set;
  }
  .set::before {
    content: counter(set, decimal-leading-zero);
    min-width: 2ch;
    color: var(--muted);
    font: 0.8125rem/1 var(--mono);
  }
  .set__name {
    font: 700 1.25rem/1.3 var(--serif);
    text-decoration: none;
  }
  .set__name:hover {
    text-decoration: underline;
  }
  .set__side {
    padding: 0 0.375rem;
    border: 1px solid var(--edge);
    border-radius: 2px;
    color: var(--muted);
    font: 0.75rem/1.5 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .set__leader {
    flex: 1 1 2rem;
    min-width: 2rem;
    border-bottom: 2px dotted var(--edge);
    transform: translateY(-0.3em);
  }
  .set__moves {
    font: 0.9375rem/1.5 var(--mono);
    color: var(--ink);
  }
  @media (max-width: 40rem) {
    .set__leader {
      display: none;
    }
    .set__moves {
      flex-basis: 100%;
      padding-left: calc(2ch + 0.75rem);
    }
  }

  /* Back page */
  .back {
    padding-block: 1rem 3.5rem;
  }
  .back__squiggle {
    display: block;
    width: min(14rem, 60%);
    height: 14px;
    color: var(--accent);
  }
  .back__squiggle path {
    stroke-width: 3px;
  }
  .back p {
    margin: 1.25rem 0 0;
    font: 1.125rem/1.5 var(--serif);
  }
  .back__note {
    color: var(--muted);
    font: 0.875rem/1.4 var(--mono) !important;
  }

  /* Motion: only when the init script says so. */
  :root[data-motion="full"] .button,
  :root[data-motion="full"] .card {
    transition: transform 140ms ease;
  }
  :root[data-motion="full"] .card:hover {
    transform: translateY(-3px) rotate(0deg);
  }
  /* Drawn on left to right. A clip, not stroke-dashoffset: dashes don't follow non-scaling strokes. */
  :root[data-motion="full"] .draw {
    clip-path: inset(-50% 100% -50% -10%);
    animation: draw 600ms 150ms ease-out forwards;
  }
  @keyframes draw {
    to {
      clip-path: inset(-50% -10% -50% -10%);
    }
  }
  /* The word starts in page ink and only turns highlight-ink as the marker lands, so it is never
     dark-on-dark, even if the animation stalls (a background tab gets no animation frames). */
  :root[data-motion="full"] .marked > span {
    color: var(--ink);
    animation: ink-on-hl 600ms 150ms ease-out forwards;
  }
  @keyframes ink-on-hl {
    to {
      color: var(--on-hl);
    }
  }
</style>
