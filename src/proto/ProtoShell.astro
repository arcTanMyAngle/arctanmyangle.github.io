---
// Document shell shared by both prototypes: theme/motion init, the "prototype" strip and the
// light/dark toggle. Each prototype supplies its own tokens and layout via the default slot.
interface Props {
  title: string;
  label: string;
  defaultTheme: "light" | "dark";
  otherHref: string;
  otherLabel: string;
}

const { title, label, defaultTheme, otherHref, otherLabel } = Astro.props;
const storageKey = `proto-theme-${defaultTheme}`;
---

<!doctype html>
<html lang="en" data-theme={defaultTheme} data-motion="full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <script is:inline define:vars={{ storageKey, defaultTheme }}>
      // Blocking, so the stored theme applies before first paint.
      var root = document.documentElement;
      var theme = defaultTheme;
      try {
        var saved = localStorage.getItem(storageKey);
        if (saved === "light" || saved === "dark") theme = saved;
      } catch (e) {}
      root.dataset.theme = theme;
      var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      root.dataset.motion = reduce ? "reduced" : "full";
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="protobar" role="note" aria-label="Prototype notice">
      <span><strong>{label}</strong> · dev-only prototype, not deployed</span>
      <span class="protobar__actions">
        <button type="button" class="protobar__toggle" data-theme-toggle data-storage-key={storageKey}>
          Switch to <span data-theme-next>{defaultTheme === "light" ? "dark" : "light"}</span>
        </button>
        <a href={otherHref}>{otherLabel}</a>
      </span>
    </div>
    <slot />
    <script>
      const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
      const next = button?.querySelector<HTMLElement>("[data-theme-next]");
      button?.addEventListener("click", () => {
        const root = document.documentElement;
        const theme = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = theme;
        if (next) next.textContent = theme === "dark" ? "light" : "dark";
        try {
          localStorage.setItem(button.dataset.storageKey ?? "", theme);
        } catch {
          // Private mode or blocked storage: the toggle still works for this page view.
        }
      });
      if (next) next.textContent = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    </script>
  </body>
</html>

<style is:global>
  .skip {
    position: absolute;
    left: 1rem;
    top: -10rem;
    z-index: 10;
    padding: 0.75rem 1rem;
    background: var(--ink);
    color: var(--bg);
    font: 600 1rem/1 system-ui, sans-serif;
  }
  .skip:focus {
    top: 1rem;
  }
  .protobar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem clamp(1rem, 4vw, 3rem);
    border-bottom: 1px dashed var(--rule);
    font: 0.8125rem/1.4 ui-monospace, "Cascadia Mono", Consolas, monospace;
    color: var(--muted);
  }
  .protobar__actions {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .protobar a,
  .protobar__toggle {
    min-height: 24px;
    color: var(--ink);
    font: inherit;
  }
  .protobar__toggle {
    padding: 0.125rem 0.625rem;
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 999px;
    cursor: pointer;
  }
</style>
