---
import BaseLayout from "../layouts/BaseLayout.astro";
import WindowFrame from "../components/WindowFrame.astro";
import ArcadeCabinet from "../components/ArcadeCabinet.astro";
import { getProjectBySlug } from "../lib/projects";

const project = getProjectBySlug("arcade");

const title = "Arcade";
const description = "One cabinet, four from-scratch games — Wii Kart, Uncanny Carnival, Galaga (C++ and Rust), and an HTML cabinet.";
---

<BaseLayout title={title} description={description}>
  <div class="shell arcade-page">
    <div class="marquee-header">insert coin // no continues, no rigged hitboxes</div>
    <p class="prose">
      A single repo housing four completely different games, all built from scratch: no game engine, deterministic
      simulation, asset-light procedural art and audio. The HTML Cabinet's five browser games are fully playable
      right here — the other three (Wii Kart, Uncanny Carnival, Galaga) need a local Rust/Node/C++ toolchain to
      run, so this cabinet is honest about that and links out to build instructions instead of faking it.
    </p>

    <WindowFrame title="cabinet.exe">
      <ArcadeCabinet variant="full" githubUrl={project?.githubUrl} />
    </WindowFrame>

    {
      project && (
        <p class="arcade-page__link">
          <a href={`/projects/${project.slug}/`}>Full writeup on the arcade project &rarr;</a>
        </p>
      )
    }
  </div>
</BaseLayout>

<style>
  .arcade-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .arcade-page__link {
    text-align: center;
  }
  .arcade-page__link a {
    color: var(--color-cyan);
    text-decoration: none;
  }
  .arcade-page__link a:hover {
    text-shadow: var(--glow-cyan);
  }
</style>
