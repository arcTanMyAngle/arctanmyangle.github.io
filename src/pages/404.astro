---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { href } from "../data/site";
---

<BaseLayout title="Page not found" section="home" description="That page doesn't exist. Here's where to go instead.">
  <header class="wrap page-head">
    <span class="eyebrow">404</span>
    <h1>No route to that page.</h1>
    <p class="lede">The address didn't match anything here. The page moved, or it never existed.</p>
    <div class="actions">
      <a class="btn btn--primary" href={href()}><Icon name="arrow" size={18} /> Back home</a>
      <a class="btn" href={href("arcade")}><Icon name="play" size={18} /> Play something</a>
    </div>
  </header>
</BaseLayout>
