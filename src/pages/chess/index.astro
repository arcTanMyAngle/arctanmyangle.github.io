---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Board from "../../components/Board.astro";
import Icon from "../../components/Icon.astro";
import { fenAfter, linePlies } from "../../lib/chessLinePlan";
import { chessLines, href, numbered } from "../../data/site";

const lines = chessLines.map((line) => ({
  ...line,
  fen: fenAfter(line.moves),
  flipped: line.side === "Black",
  // Move tokens with their 1-based ply, so the move list can highlight as the board plays.
  tokens: line.moves.map((san, i) => ({ ply: i + 1, num: i % 2 === 0 ? `${i / 2 + 1}.` : "", san })),
}));
const white = lines.filter((l) => l.side === "White");
const black = lines.filter((l) => l.side === "Black");
const groups = [
  { id: "white", title: "With White", text: "Openings I aim for when I move first.", lines: white },
  { id: "black", title: "With Black", text: "Shown from Black's side of the board.", lines: black },
];
---

<BaseLayout title="Chess" section="chess" description="The openings I play, each on its own animated board, and a board to play the computer or a friend.">
  <header class="wrap page-head">
    <span class="eyebrow">Chess</span>
    <h1>The openings I play.</h1>
    <p class="lede">
      {lines.length} lines, each played out move by move. Pause one, step through it with the arrow keys, or take it to
      the two-player board and play it out with a friend.
    </p>
    <div class="actions">
      <a class="btn btn--primary" href={href("chess/play")}>
        <Icon name="users" />
        Play a friend
      </a>
      <a class="btn" href="#white">Browse openings</a>
    </div>
  </header>

  {
    groups.map((group) => (
      <section class="wrap section lines-section" id={group.id} aria-labelledby={`${group.id}-h`}>
        <div class="section__head">
          <div>
            <h2 id={`${group.id}-h`}>{group.title}</h2>
            <p>{group.text}</p>
          </div>
        </div>
        <div class="lines">
          {group.lines.map((line) => (
            <article class="card line" data-line data-plies={JSON.stringify(linePlies(line.moves))} aria-labelledby={`line-${line.slug}`}>
              <div class="line__board">
                <Board fen={line.fen} flipped={line.flipped} label={`${line.name}: ${numbered(line.moves)}`} />
              </div>
              <div class="line__body">
                <div class="line__top">
                  <h3 id={`line-${line.slug}`}>{line.name}</h3>
                  <span class="badge badge--muted">{line.side}</span>
                </div>
                <p class="line__moves mono" aria-label="Moves">
                  {line.tokens.map((t) => (
                    <span class="mv" data-ply={t.ply}>
                      {t.num && <span class="mv__n">{t.num}</span>}
                      {t.san}
                    </span>
                  ))}
                </p>
                <p class="line__idea">{line.idea}</p>
                <div class="line__bar">
                  <div class="line__ctrls" role="group" aria-label={`${line.name} playback`}>
                    <button type="button" class="ctrl" data-act="restart" aria-label="Back to start">
                      <Icon name="restart" size={16} />
                    </button>
                    <button type="button" class="ctrl" data-act="prev" aria-label="Previous move">
                      <Icon name="prev" size={16} />
                    </button>
                    <button type="button" class="ctrl ctrl--play" data-act="play" aria-label="Play" aria-pressed="false">
                      <Icon name="play" size={16} class="ctrl__play" />
                      <Icon name="pause" size={16} class="ctrl__pause" />
                    </button>
                    <button type="button" class="ctrl" data-act="next" aria-label="Next move">
                      <Icon name="next" size={16} />
                    </button>
                  </div>
                  <a class="btn btn--small" href={`${href("chess/play")}?line=${line.slug}`}>
                    Play from here
                    <Icon name="arrow" size={16} />
                  </a>
                </div>
                <p class="line__status mono" data-status>Final position</p>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))
  }

  <section class="wrap section">
    <a class="card card--lift cta" href={href("chess/play")} data-spotlight>
      <div>
        <span class="eyebrow">Play a game</span>
        <h2>Play the computer, or a friend.</h2>
        <p>Three computer levels, or pass and play on one screen, with clocks, undo and a full move list. The game survives a closed tab.</p>
      </div>
      <span class="btn btn--primary" aria-hidden="true">
        Sit down
        <Icon name="arrow" />
      </span>
    </a>
  </section>
</BaseLayout>

<script>
  import { mount } from "../../components/chessLine";
  document.querySelectorAll<HTMLElement>("[data-line]").forEach((el) => mount(el));
</script>

<style>
  .lines-section {
    padding-top: 1rem;
  }
  .lines {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: 1rem;
  }
  .line {
    display: flex;
    flex-direction: column;
  }
  .line__board {
    padding: 1rem 1rem 0;
  }
  .line__body {
    display: grid;
    gap: 0.75rem;
    padding: 1.125rem 1.25rem 1.25rem;
  }
  .line__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .line__top h3 {
    font-size: 1.25rem;
    letter-spacing: -0.025em;
  }
  .line__moves {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    font-size: 0.875rem;
  }
  .mv {
    padding: 0.125rem 0.375rem;
    border-radius: 6px;
    color: var(--text-2);
  }
  .mv__n {
    margin-right: 0.125rem;
    color: var(--text-3);
  }
  .mv:global(.is-current) {
    background: var(--hue-soft);
    color: var(--text);
    box-shadow: inset 0 0 0 1px var(--hue-line);
  }
  :global(:root[data-motion="full"]) .mv {
    transition:
      background-color 200ms var(--ease),
      color 200ms var(--ease);
  }
  .line__idea {
    color: var(--text-2);
    font-size: 0.9375rem;
  }
  .line__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }
  .line__ctrls {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface-2);
  }
  .ctrl {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--text-2);
    cursor: pointer;
  }
  .ctrl:hover {
    background: var(--surface-3);
    color: var(--text);
  }
  .ctrl--play {
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 0 0 1px var(--line-2);
  }
  .ctrl--play :global(.ctrl__pause),
  .ctrl--play[aria-pressed="true"] :global(.ctrl__play) {
    display: none;
  }
  .ctrl--play[aria-pressed="true"] :global(.ctrl__pause) {
    display: block;
  }
  .line__status {
    min-height: 1.4em;
    color: var(--text-3);
    font-size: 0.75rem;
    white-space: pre;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background:
      radial-gradient(40rem 18rem at 100% 0%, var(--hue-soft), transparent 70%),
      var(--surface);
  }
  .cta > * {
    position: relative;
    z-index: 1;
  }
  .cta h2 {
    margin-top: 0.75rem;
    font-size: clamp(1.625rem, 3vw, 2.25rem);
    letter-spacing: -0.035em;
  }
  .cta p {
    max-width: 48ch;
    margin-top: 0.5rem;
    color: var(--text-2);
  }
</style>
