---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GameFrame from "../../components/GameFrame.astro";
import Board from "../../components/Board.astro";
import Icon from "../../components/Icon.astro";
import { chessLines } from "../../data/site";

const linesJson = JSON.stringify(chessLines.map(({ slug, name, side, moves }) => ({ slug, name, side, moves })));
const seats = [
  { color: "b", label: "Black" },
  { color: "w", label: "White" },
] as const;
---

<BaseLayout title="Play chess" section="chess" description="Chess against the computer (easy, medium or hard) or pass and play with a friend, with clocks, undo and a move list.">
  <div data-chess-play data-lines={linesJson}>
    <GameFrame
      title="Play chess"
      lede="Play the computer, or pass and play with a friend: pick in Settings. Drag or click a piece, or use the arrow keys and Enter. The game is saved on this device, so a closed tab doesn't end it."
      back={{ label: "Chess", path: "chess" }}
    >
      <div class="note cp-note" data-note hidden>
        <Icon name="flip" size={18} />
        <span data-note-text></span>
        <span class="cp-note__acts">
          <button type="button" class="btn btn--small" data-act="restore" hidden>Bring back my game</button>
          <button type="button" class="btn btn--small" data-act="dismiss">Dismiss</button>
        </span>
      </div>

      <div class="card table" data-table>
        {
          seats.map((s) => (
            <div class="seat" data-seat={s.color}>
              <span class:list={["seat__dot", `seat__dot--${s.color}`]} aria-hidden="true" />
              <label class="seat__name">
                <span class="sr-only">{s.label} player name</span>
                <input type="text" data-name placeholder={s.label} maxlength="24" autocomplete="off" spellcheck="false" />
              </label>
              <span class="seat__caps" data-captured />
              <span class="seat__clock mono" data-clock hidden>
                <Icon name="clock" size={14} />
                <span data-time>0:00</span>
              </span>
            </div>
          ))
        }
        <div class="table__board">
          <Board />
        </div>
      </div>
      <noscript>
        <p class="note">The board needs JavaScript to play. The pieces above show the starting position.</p>
      </noscript>

      <Fragment slot="side">
        <section class="panel" aria-labelledby="cp-game">
          <h2 id="cp-game">Game</h2>
          <p class="cp-status" id="cp-status" data-status>White to move.</p>
          <div class="cp-moves">
            <p class="muted cp-moves__empty" data-moves-empty>No moves yet. White starts.</p>
            <ol class="mvl mono" data-moves aria-label="Moves"></ol>
          </div>
          <div class="cp-acts">
            <button type="button" class="btn btn--small" data-act="undo" disabled>
              <Icon name="undo" size={16} />
              <span data-label>Undo</span>
            </button>
            <button type="button" class="btn btn--small" data-act="flip">
              <Icon name="flip" size={16} />
              <span data-label>Flip board</span>
            </button>
            <button type="button" class="btn btn--small" data-act="new">
              <Icon name="restart" size={16} />
              <span data-label>New game</span>
            </button>
            <button type="button" class="btn btn--small" data-act="copy" disabled>
              <span data-label>Copy PGN</span>
            </button>
            <button type="button" class="btn btn--small" data-act="draw" disabled>
              <span data-label>Agree a draw</span>
            </button>
            <button type="button" class="btn btn--small" data-act="resign">
              <span data-label>Resign as White</span>
            </button>
          </div>
        </section>

        <section class="panel" aria-labelledby="cp-settings">
          <h2 id="cp-settings">Settings</h2>
          <div class="cp-settings">
            <label class="field">
              Opponent
              <select data-opponent>
                <option value="friend">A friend on this screen</option>
                <option value="easy">Computer: Easy</option>
                <option value="medium">Computer: Medium</option>
                <option value="hard">Computer: Hard</option>
              </select>
            </label>
            <label class="field" data-side-field hidden>
              You play
              <select data-side>
                <option value="w">White</option>
                <option value="b">Black</option>
              </select>
            </label>
            <label class="field">
              Clock
              <select data-tc>
                <option value="off">Off</option>
                <option value="3+2">3 min + 2 s a move</option>
                <option value="5+0">5 min</option>
                <option value="10+0">10 min</option>
              </select>
            </label>
            <p class="muted cp-hint" data-tc-hint hidden>Starts with the next game.</p>
            <label class="cp-check">
              <input type="checkbox" data-autoflip />
              Turn the board for whoever is to move
            </label>
          </div>
        </section>

        <section class="panel" aria-labelledby="cp-howto">
          <h2 id="cp-howto">How to play</h2>
          <ul class="howto" role="list">
            <li><span class="kbd">Drag</span> Or click a piece, then click where it goes.</li>
            <li><span class="kbd">Arrows</span> Move around the board. Enter or Space picks up and puts down.</li>
            <li><span class="kbd">Esc</span> Put a piece back down.</li>
            <li><span class="kbd">Clock</span> Starts after White's first move and pauses if you leave the tab.</li>
          </ul>
        </section>
      </Fragment>
    </GameFrame>
    <p class="sr-only" aria-live="polite" data-live></p>
  </div>
</BaseLayout>

<script>
  import { mount } from "../../components/chessPlay";
  const root = document.querySelector<HTMLElement>("[data-chess-play]");
  if (root) mount(root);
</script>

<style>
  .cp-note {
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .cp-settings [hidden],
  .cp-note[hidden],
  .cp-note [hidden] {
    display: none;
  }
  .cp-note__acts {
    display: inline-flex;
    gap: 0.5rem;
    margin-left: auto;
  }

  /* The table: one seat above the board and one below. Flipping the board swaps them. */
  .table {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: min(100%, 40rem, max(18rem, 100svh - 13rem));
    margin-inline: auto;
    padding: 0.875rem;
  }
  .table__board {
    order: 2;
  }
  .seat[data-seat="b"] {
    order: 1;
  }
  .seat[data-seat="w"] {
    order: 3;
  }
  .table:global([data-flipped]) .seat[data-seat="b"] {
    order: 3;
  }
  .table:global([data-flipped]) .seat[data-seat="w"] {
    order: 1;
  }
  .seat {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    padding: 0.375rem 0.5rem 0.375rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
    background: var(--surface-2);
  }
  .seat:global(.is-turn) {
    border-color: var(--hue-line);
    background: var(--hue-soft);
  }
  .seat:global(.is-winner) {
    border-color: var(--hue);
  }
  :global(:root[data-motion="full"]) .seat {
    transition:
      background-color 240ms var(--ease),
      border-color 240ms var(--ease);
  }
  .seat__dot {
    flex-shrink: 0;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--line-2);
  }
  .seat__dot--w {
    background: #fbfaf6;
  }
  .seat__dot--b {
    background: #23262e;
  }
  .seat__name {
    flex: 0 1 9rem;
    min-width: 7.5rem;
  }
  .seat__name input {
    width: 100%;
    min-height: 2rem;
    padding: 0 0.5rem;
    border: 1px solid transparent;
    border-radius: 6px;
    background: transparent;
    color: var(--text);
    font: 600 0.9375rem var(--sans);
    text-overflow: ellipsis;
  }
  .seat__name input::placeholder {
    color: var(--text);
    opacity: 1;
  }
  .seat__name input:hover,
  .seat__name input:focus {
    border-color: var(--line-2);
    background: var(--surface);
  }
  .seat__caps {
    display: flex;
    flex: 1;
    flex-wrap: wrap;
    align-items: center;
    min-width: 0;
    min-height: 1.25rem;
  }
  .seat__caps :global(.cap) {
    width: 1.25rem;
    height: 1.25rem;
    margin-right: -0.375rem;
  }
  .seat__caps :global(.cap .pc-svg) {
    width: 100%;
    height: 100%;
    padding: 0;
  }
  .seat__caps :global(.adv) {
    margin-left: 0.625rem;
    color: var(--text-2);
    font: 600 0.8125rem var(--mono);
  }
  .seat__clock {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    flex-shrink: 0;
    padding: 0.25rem 0.625rem;
    border-radius: 6px;
    background: var(--surface);
    color: var(--text-2);
    font-size: 1.0625rem;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    box-shadow: 0 0 0 1px var(--line);
  }
  .seat__clock[hidden] {
    display: none;
  }
  .seat__clock:global(.is-running) {
    background: var(--solid);
    color: var(--on-solid);
  }
  .seat__clock:global(.is-low) {
    color: #ef4444;
  }
  .seat__clock:global(.is-running.is-low) {
    background: #b42318;
    color: #fff;
  }

  /* Hit squares, promotion picker and the result card are built by chessPlay.ts. */
  .table :global(.hits) {
    position: absolute;
    inset: 0;
    touch-action: none;
  }
  .table :global(.hit) {
    position: absolute;
    left: 0;
    top: 0;
    width: 12.5%;
    height: 12.5%;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    transform: translate(calc(var(--x, 0) * 100%), calc(var(--y, 0) * 100%));
    cursor: default;
    -webkit-tap-highlight-color: transparent;
  }
  .table :global(.hit[data-own]),
  .table :global(.hit[data-target]) {
    cursor: pointer;
  }
  .table :global(.hit:focus) {
    outline: none;
  }
  .table :global(.hit:focus-visible) {
    z-index: 6;
    box-shadow:
      inset 0 0 0 3px var(--chess),
      inset 0 0 0 5px rgb(0 0 0 / 0.45);
  }
  .table :global(.promo),
  .table :global(.over) {
    position: absolute;
    inset: 0;
    z-index: 8;
    display: grid;
    place-items: center;
    padding: 1rem;
    background: rgb(8 10 14 / 0.55);
  }
  .table :global(.promo[hidden]),
  .table :global(.over[hidden]) {
    display: none;
  }
  .table :global(.promo__box),
  .table :global(.over__box) {
    display: grid;
    gap: 0.75rem;
    max-width: 22rem;
    padding: 1.125rem;
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    text-align: center;
  }
  .table :global(.promo__title) {
    color: var(--text-2);
    font: 600 0.75rem/1.4 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .table :global(.promo__row) {
    display: flex;
    gap: 0.5rem;
  }
  .table :global(.promo__btn) {
    width: clamp(3rem, 12cqi, 4.5rem);
    aspect-ratio: 1;
    padding: 0.25rem;
    border: 1px solid var(--line-2);
    border-radius: var(--radius-s);
    background: var(--board-light);
    cursor: pointer;
  }
  .table :global(.promo__btn:hover),
  .table :global(.promo__btn:focus-visible) {
    border-color: var(--chess);
    box-shadow: 0 0 0 2px var(--chess);
    outline: none;
  }
  .table :global(.promo__btn .pc-svg) {
    padding: 4%;
  }
  .table :global(.over__title) {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .table :global(.over__text) {
    color: var(--text-2);
    font-size: 0.9375rem;
  }
  .table :global(.over__row) {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }
  :global(:root[data-motion="full"]) .table :global(.over__box),
  :global(:root[data-motion="full"]) .table :global(.promo__box) {
    animation: cp-rise 260ms var(--ease);
  }
  @keyframes cp-rise {
    from {
      transform: translateY(8px) scale(0.98);
    }
  }

  /* Side panel */
  .cp-status {
    font-weight: 600;
  }
  .cp-moves {
    max-height: 14rem;
    margin-top: 0.875rem;
    overflow-y: auto;
    border-top: 1px solid var(--line);
    padding-top: 0.75rem;
  }
  .cp-moves__empty {
    font-size: 0.875rem;
  }
  .cp-moves__empty[hidden] {
    display: none;
  }
  .mvl {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }
  .mvl :global(li) {
    display: grid;
    grid-template-columns: 2.25rem 1fr 1fr;
    align-items: center;
  }
  .mvl :global(.mvl__n) {
    color: var(--text-3);
  }
  .mvl :global(.mvl__m) {
    padding: 0.125rem 0.375rem;
    border-radius: 6px;
    color: var(--text-2);
  }
  .mvl :global(.mvl__m.is-last) {
    background: var(--hue-soft);
    color: var(--text);
    box-shadow: inset 0 0 0 1px var(--hue-line);
  }
  .cp-acts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .cp-acts :global(button[data-confirming]) {
    border-color: var(--hue);
    color: var(--text);
  }
  .cp-settings {
    display: grid;
    gap: 0.875rem;
  }
  .cp-hint {
    margin-top: -0.5rem;
    font-size: 0.8125rem;
  }
  .cp-hint[hidden] {
    display: none;
  }
  .cp-check {
    display: flex;
    gap: 0.625rem;
    align-items: flex-start;
    color: var(--text-2);
    font-size: 0.875rem;
    cursor: pointer;
  }
  .cp-check input {
    width: 1.125rem;
    height: 1.125rem;
    margin: 0.125rem 0 0;
    accent-color: var(--chess);
  }

  @media (max-width: 30rem) {
    .table {
      padding: 0.5rem;
    }
    .seat__name {
      flex-basis: 6.5rem;
    }
  }
</style>
