---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { githubUrl } from "../../data/site";
import { getAllProjects, getFeaturedProjects, type Project } from "../../lib/projects";

// Everything here comes from the committed GitHub snapshot plus the hand-written overrides. Metrics a repo
// doesn't have (no license, no stars) are left out rather than shown as zero.
const featured = getFeaturedProjects();
const featuredSlugs = new Set(featured.map((p) => p.slug));
const others = getAllProjects().filter(
  (p) => !p.fork && p.status !== "archive" && p.status !== "fork" && !featuredSlugs.has(p.slug),
);

const month = new Intl.DateTimeFormat("en-GB", { month: "short", year: "numeric", timeZone: "UTC" });
const updated = (p: Project) => month.format(new Date(p.updatedAt));
const stack = (p: Project) => (p.techStack.length ? p.techStack : p.primaryLanguage ? [p.primaryLanguage] : []).slice(0, 4);
---

<BaseLayout title="Projects" section="projects" description="Code on GitHub: what each project is, what it's built with, and where to read it.">
  <header class="wrap page-head">
    <span class="eyebrow">Projects</span>
    <h1>The code behind it all.</h1>
    <p class="lede">
      Everything is open on GitHub. These are the projects I'd show you first, then everything else that's still
      active.
    </p>
    <div class="actions">
      <a class="btn" href={githubUrl}><Icon name="github" size={18} /> GitHub profile</a>
    </div>
  </header>

  <section class="wrap" aria-labelledby="featured-h">
    <h2 id="featured-h" class="sr-only">Featured projects</h2>
    <ul class="pj" role="list">
      {
        featured.map((p, i) => (
          <li class="card card--lift pj__card" data-spotlight>
            <div class="pj__top">
              <span class="pj__n mono">{String(i + 1).padStart(2, "0")}</span>
              {p.primaryLanguage && <span class="kbd">{p.primaryLanguage}</span>}
            </div>
            <h3>
              <a class="card__link" href={p.githubUrl}>
                {p.displayName}
              </a>
            </h3>
            <p>{p.description}</p>
            {stack(p).length > 0 && (
              <ul class="pj__stack" role="list" aria-label="Built with">
                {stack(p).map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            )}
            <div class="pj__foot">
              <span class="mono">{p.repoName}</span>
              <span class="pj__meta">
                {p.license && <span>{p.license}</span>}
                {p.stars > 0 && <span>★ {p.stars}</span>}
                <span>Updated {updated(p)}</span>
              </span>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  {
    others.length > 0 && (
      <section class="wrap section" aria-labelledby="more-h">
        <div class="section__head">
          <div>
            <h2 id="more-h">Everything else</h2>
            <p>Smaller and newer projects, most recently updated first.</p>
          </div>
        </div>
        <ul class="more" role="list">
          {others.map((p) => (
            <li>
              <a href={p.githubUrl}>
                <span class="more__name">
                  <span class="mono">{p.repoName}</span>
                  {p.description && <span class="more__desc">{p.description}</span>}
                </span>
                <span class="more__meta">
                  {p.primaryLanguage && <span>{p.primaryLanguage}</span>}
                  <span>{updated(p)}</span>
                  <Icon name="external" size={16} />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<style>
  .pj {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pj__card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
  }
  .pj__card > * {
    position: relative;
    z-index: 1;
  }
  .pj__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .pj__n {
    color: var(--hue);
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .pj__top .kbd {
    color: var(--text-2);
    font-size: 0.75rem;
  }
  .pj__card h3 {
    font-size: 1.375rem;
    letter-spacing: -0.02em;
  }
  .pj__card p {
    color: var(--text-2);
  }
  .pj__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pj__stack li {
    padding: 0.1875rem 0.625rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--text-2);
    font-size: 0.8125rem;
  }
  .pj__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
    color: var(--text-3);
    font-size: 0.8125rem;
  }
  .pj__meta {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .more {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }
  .more li + li {
    border-top: 1px solid var(--line);
  }
  .more a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.875rem 1.25rem;
    color: var(--text);
    text-decoration: none;
  }
  .more a:hover {
    background: var(--surface-2);
  }
  .more a:focus-visible {
    outline-offset: -3px;
  }
  .more__name {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
  }
  .more__name .mono {
    font-weight: 600;
  }
  .more__desc {
    overflow: hidden;
    color: var(--text-2);
    font-size: 0.875rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .more__meta {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.875rem;
    color: var(--text-3);
    font-size: 0.8125rem;
  }

  @media (max-width: 48rem) {
    .pj {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 30rem) {
    .more a {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.375rem;
    }
    .more__name,
    .more__desc {
      max-width: 100%;
    }
  }
</style>
