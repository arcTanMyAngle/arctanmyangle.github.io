---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHead from "../../components/SectionHead.astro";
import ProjectGrid from "../../components/ProjectGrid.astro";
import { getAllProjects } from "../../lib/projects";

const projects = getAllProjects();
const categories = [...new Set(projects.map((p) => p.category))].sort();
const statuses = [...new Set(projects.map((p) => p.status))].sort();

const title = "Projects";
const description = "Every real project on arcTanMyAngle's GitHub, filterable by category and status.";
---

<BaseLayout title={title} description={description}>
  <div class="shell">
    <SectionHead label="Project archive" meta={`${projects.length} repositories`} />

    <div class="project-filters" id="project-filters">
      <label class="visually-hidden" for="project-search">Search projects</label>
      <input
        class="field project-filters__search"
        id="project-search"
        type="text"
        placeholder="Search projects..."
        autocomplete="off"
      />
      <label class="visually-hidden" for="project-category">Filter by category</label>
      <select class="field" id="project-category">
        <option value="all">All categories</option>
        {categories.map((c) => <option value={c}>{c.replace(/-/g, " ")}</option>)}
      </select>
      <label class="visually-hidden" for="project-status">Filter by status</label>
      <select class="field" id="project-status">
        <option value="all">All statuses</option>
        {statuses.map((s) => <option value={s}>{s}</option>)}
      </select>
      <label class="visually-hidden" for="project-sort">Sort by</label>
      <select class="field" id="project-sort">
        <option value="updated-desc">Recently updated</option>
        <option value="stars-desc">Most stars</option>
        <option value="name-asc">Name A–Z</option>
      </select>
      <button type="button" class="beveled-button beveled-button--ghost beveled-button--sm" data-filter-reset hidden>
        Clear filters
      </button>
    </div>

    <p class="project-filters__count" data-result-count aria-live="polite">{projects.length} repositories</p>

    <ProjectGrid projects={projects} id="project-grid" reveal />
  </div>
</BaseLayout>

<script>
  import { mount } from "../../components/ProjectFilters";
  const root = document.getElementById("project-filters");
  if (root) mount(root, { gridId: "project-grid" });
</script>

<style>
  .shell {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .project-filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .project-filters__search {
    flex: 1 1 220px;
  }
  .project-filters__count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    margin-top: calc(var(--space-3) * -1);
  }
</style>
