---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import { getFeaturedProjects } from "../lib/projects";

const featured = getFeaturedProjects();

const title = "arcTanMyAngle";
const description =
  "arcTanMyAngle // project signal deck — real-time systems, Rust/C++, edge ML, and handmade games.";
---

<BaseLayout title={title} description={description}>
  <section class="hero">
    <canvas class="hero__canvas" id="hero-bg" aria-hidden="true"></canvas>
    <div class="shell hero__content">
      <p class="hero__eyebrow">// project signal deck</p>
      <h1 class="hero__title">arcTanMyAngle</h1>
      <p class="hero__lede prose">
        Real-time systems, Rust/C++ tools, edge ML, and handmade games — built from scratch, shipped as working
        code, not slideware.
      </p>
      <div class="hero__actions">
        <a class="beveled-button beveled-button--lg beveled-button--primary" href="/lab/">Enter the Lab</a>
        <a class="beveled-button beveled-button--lg beveled-button--cyan" href="/projects/">Browse Projects</a>
        <a class="beveled-button beveled-button--lg beveled-button--magenta" href="/arcade/">Insert Coin</a>
      </div>
    </div>
  </section>

  <div class="shell">
    <div class="marquee-header">featured signals // {featured.length} entries</div>
    <ProjectGrid projects={featured} />
    <p class="home__more">
      <a href="/projects/">See the full archive &rarr;</a>
    </p>
  </div>
</BaseLayout>

<script>
  import { mount } from "../components/HeroCanvas";
  const canvas = document.getElementById("hero-bg") as HTMLCanvasElement | null;
  if (canvas) mount(canvas);
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(70vh, 640px);
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-8);
  }
  .hero__eyebrow {
    color: var(--color-amber);
    text-shadow: var(--glow-amber);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: var(--text-sm);
  }
  .hero__title {
    font-size: var(--text-3xl);
    color: var(--color-blue);
    text-shadow: var(--glow-blue);
  }
  .hero__lede {
    max-width: 56ch;
    color: var(--color-text-dim);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  .home__more {
    text-align: center;
    padding-block: var(--space-6);
  }
  .home__more a {
    color: var(--color-cyan);
    text-decoration: none;
  }
  .home__more a:hover {
    text-shadow: var(--glow-cyan);
  }
</style>
