---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { href } from "../data/site";

const tricks = [
  { id: "ollie", name: "Ollie", text: "Pop the tail, slide the front foot up, and the board rises with you." },
  { id: "kickflip", name: "Kickflip", text: "An ollie, but the front foot flicks off the edge and the board spins under you." },
  { id: "shuvit", name: "Shove-it", text: "The back foot scoops the tail and the board turns half a circle flat." },
];
const aims = [
  { title: "Flatground first", text: "Ollies, flips and shove-its on flat ground before any ramps." },
  { title: "Timing you can feel", text: "Pop and catch depend on when you press, not on a button per trick." },
  { title: "Keyboard or touch", text: "Plays on a laptop or a phone, like the rest of the arcade." },
  { title: "Small and quick", text: "Loads in the browser straight away. No account, no download." },
];
---

<BaseLayout title="Skate" section="skate" description="A flatground skateboarding sim for the browser, in the works.">
  <header class="wrap page-head">
    <span class="eyebrow">Skate</span>
    <h1>A skate sim, in the works.</h1>
    <p class="lede">
      I skate, and I want a browser game that gets the feel right: the timing of the pop, the flick, the catch. It
      starts on flat ground. Here's the idea, one trick at a time.
    </p>
    <div class="actions">
      <span class="badge badge--muted">Not playable yet</span>
    </div>
  </header>

  <section class="wrap" aria-labelledby="tricks-h">
    <div class="card sk" data-skate data-trick="ollie">
      <div class="sk__head">
        <h2 id="tricks-h">Tricks it will start with</h2>
        <div class="sk__picks" role="radiogroup" aria-label="Trick">
          {
            tricks.map((t, i) => (
              <button type="button" class="sk__pick" role="radio" aria-checked={i === 0 ? "true" : "false"} data-pick={t.id}>
                {t.name}
              </button>
            ))
          }
        </div>
      </div>

      <div class="sk__stage" aria-hidden="true">
        <svg viewBox="0 0 320 150" class="sk__svg">
          <line class="sk__ground" x1="0" y1="132" x2="320" y2="132"></line>
          <ellipse class="sk__shadow" cx="160" cy="132" rx="70" ry="4"></ellipse>
          <g class="sk__lift">
            <g class="sk__spin">
              <g class="sk__board">
                <path class="sk__deck" d="M80 100q5 11 21 11h118q16 0 21-11"></path>
                <rect class="sk__truck" x="112" y="112" width="18" height="5" rx="2"></rect>
                <rect class="sk__truck" x="190" y="112" width="18" height="5" rx="2"></rect>
                <circle class="sk__wheel" cx="117" cy="123" r="7"></circle>
                <circle class="sk__wheel" cx="203" cy="123" r="7"></circle>
              </g>
            </g>
          </g>
        </svg>
      </div>

      {
        tricks.map((t, i) => (
          <p class="sk__text" data-text={t.id} hidden={i !== 0}>
            <strong>{t.name}.</strong> {t.text}
          </p>
        ))
      }
    </div>
  </section>

  <section class="wrap section" aria-labelledby="aims-h">
    <div class="section__head">
      <div>
        <h2 id="aims-h">What it's aiming for</h2>
        <p>Goals, not features that exist yet.</p>
      </div>
    </div>
    <ul class="aims" role="list">
      {
        aims.map((a, i) => (
          <li class="card">
            <span class="aims__n mono">0{i + 1}</span>
            <strong>{a.title}</strong>
            <span>{a.text}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap section">
    <p class="note">
      <Icon name="play" size={18} />
      <span>While you wait, the <a href={href("arcade")}>arcade</a> has games you can play right now.</span>
    </p>
  </section>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>("[data-skate]");
  if (root) {
    const picks = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-pick]"));
    const texts = Array.from(root.querySelectorAll<HTMLElement>("[data-text]"));
    const select = (btn: HTMLButtonElement, focus = false) => {
      const id = btn.dataset.pick!;
      root.dataset.trick = id;
      for (const p of picks) {
        const on = p === btn;
        p.setAttribute("aria-checked", String(on));
        p.tabIndex = on ? 0 : -1;
      }
      for (const t of texts) t.hidden = t.dataset.text !== id;
      if (focus) btn.focus();
    };
    picks.forEach((p, i) => {
      p.tabIndex = i === 0 ? 0 : -1;
      p.addEventListener("click", () => select(p));
      p.addEventListener("keydown", (e) => {
        const step = e.key === "ArrowRight" || e.key === "ArrowDown" ? 1 : e.key === "ArrowLeft" || e.key === "ArrowUp" ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        select(picks[(i + step + picks.length) % picks.length], true);
      });
    });
  }
</script>

<style>
  .sk {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .sk__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .sk__head h2 {
    font-size: 1.375rem;
    letter-spacing: -0.03em;
  }
  .sk__picks {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface-2);
  }
  .sk__pick {
    min-height: 2.25rem;
    padding: 0 0.875rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--text-2);
    font: 600 0.875rem var(--sans);
    cursor: pointer;
  }
  .sk__pick:hover {
    color: var(--text);
  }
  .sk__pick[aria-checked="true"] {
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 0 0 1px var(--hue-line);
  }
  .sk__stage {
    display: grid;
    place-items: center;
    padding: 1rem;
    border-radius: var(--radius-s);
    background:
      radial-gradient(30rem 12rem at 50% 100%, var(--hue-soft), transparent 70%),
      var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .sk__svg {
    width: min(100%, 34rem);
    height: auto;
    overflow: visible;
  }
  .sk__ground {
    stroke: var(--line-2);
    stroke-width: 2;
  }
  .sk__deck {
    fill: none;
    stroke: var(--hue);
    stroke-width: 8;
    stroke-linecap: round;
  }
  .sk__truck {
    fill: var(--text-3);
  }
  .sk__wheel {
    fill: var(--surface-3);
    stroke: var(--text-2);
    stroke-width: 2;
  }
  .sk__shadow {
    fill: color-mix(in oklab, var(--text) 12%, transparent);
  }
  .sk__shadow,
  .sk__lift,
  .sk__spin,
  .sk__board {
    transform-box: fill-box;
    transform-origin: center;
  }
  .sk__text {
    max-width: 60ch;
    color: var(--text-2);
  }
  .sk__text strong {
    color: var(--text);
  }
  .sk__text[hidden] {
    display: none;
  }

  /* One 2.6s loop per trick. The lift (up and down) is shared; the spin layer does the trick itself.
     Under reduced motion nothing moves and the board just sits on the ground. */
  :global(:root[data-motion="full"]) .sk__lift {
    animation: sk-lift 2.6s cubic-bezier(0.35, 0, 0.25, 1) infinite;
  }
  :global(:root[data-motion="full"]) .sk__shadow {
    animation: sk-shadow 2.6s cubic-bezier(0.35, 0, 0.25, 1) infinite;
  }
  :global(:root[data-motion="full"]) .sk[data-trick="ollie"] .sk__board {
    transform-origin: 18% 80%;
    animation: sk-ollie 2.6s cubic-bezier(0.35, 0, 0.25, 1) infinite;
  }
  :global(:root[data-motion="full"]) .sk[data-trick="kickflip"] .sk__spin {
    animation: sk-flip 2.6s cubic-bezier(0.35, 0, 0.25, 1) infinite;
  }
  :global(:root[data-motion="full"]) .sk[data-trick="shuvit"] .sk__spin {
    animation: sk-shuv 2.6s cubic-bezier(0.35, 0, 0.25, 1) infinite;
  }
  @keyframes sk-lift {
    0%,
    30% {
      transform: none;
    }
    55% {
      transform: translateY(-44px);
    }
    76% {
      transform: none;
    }
    80% {
      transform: translateY(1px);
    }
    84%,
    100% {
      transform: none;
    }
  }
  @keyframes sk-shadow {
    0%,
    30%,
    76%,
    100% {
      transform: none;
      opacity: 1;
    }
    55% {
      transform: scaleX(0.55);
      opacity: 0.5;
    }
  }
  @keyframes sk-ollie {
    0%,
    30% {
      transform: none;
    }
    38% {
      transform: rotate(-15deg);
    }
    55% {
      transform: rotate(-3deg);
    }
    66% {
      transform: rotate(2deg);
    }
    76%,
    100% {
      transform: none;
    }
  }
  /* Seen from the side, a kickflip rolls the board along its length: the deck shows its edge, then its grip. */
  @keyframes sk-flip {
    0%,
    34% {
      transform: none;
    }
    46% {
      transform: scaleY(-1);
    }
    58% {
      transform: scaleY(1);
    }
    76%,
    100% {
      transform: none;
    }
  }
  /* A shove-it turns flat, so from the side the board looks like it shrinks to its width and swaps ends. */
  @keyframes sk-shuv {
    0%,
    34% {
      transform: none;
    }
    50% {
      transform: scaleX(0.12);
    }
    66% {
      transform: scaleX(-1);
    }
    76%,
    100% {
      transform: scaleX(-1);
    }
  }

  .aims {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .aims li {
    display: grid;
    gap: 0.375rem;
    align-content: start;
    padding: 1.25rem;
  }
  .aims__n {
    color: var(--hue);
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .aims span:last-child {
    color: var(--text-2);
    font-size: 0.9375rem;
  }
  @media (max-width: 60rem) {
    .aims {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 30rem) {
    .aims {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
