---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";

// Open chord shapes, low E string first. -1 = not played, 0 = open, n = fret.
const chords = [
  { id: "em", name: "E minor", frets: [0, 2, 2, 0, 0, 0] },
  { id: "g", name: "G major", frets: [3, 2, 0, 0, 0, 3] },
  { id: "c", name: "C major", frets: [-1, 3, 2, 0, 1, 0] },
  { id: "d", name: "D major", frets: [-1, -1, 0, 2, 3, 2] },
];
const strings = ["E", "A", "D", "G", "B", "e"];
const first = chords[0];
const chordJson = JSON.stringify(chords.map(({ id, frets }) => ({ id, frets })));
---

<BaseLayout title="Tabs" section="tabs" description="Guitar tabs you can follow one bar at a time. Coming soon.">
  <header class="wrap page-head">
    <span class="eyebrow">Tabs</span>
    <h1>Guitar tabs, one bar at a time.</h1>
    <p class="lede">
      A tab player is coming: the bar you're on lights up, the tempo is yours, and any bar can loop until it's in your
      hands. For now, here are the four chords most songs start with.
    </p>
    <div class="actions">
      <span class="badge badge--muted">Coming soon</span>
    </div>
  </header>

  <section class="wrap" aria-labelledby="chords-h">
    <div class="card fb" data-chords={chordJson}>
      <div class="fb__head">
        <h2 id="chords-h">Four open chords</h2>
        <div class="fb__picks" role="radiogroup" aria-label="Chord">
          {
            chords.map((c, i) => (
              <button type="button" class="fb__pick" role="radio" aria-checked={i === 0 ? "true" : "false"} data-chord={c.id}>
                {c.name}
              </button>
            ))
          }
        </div>
      </div>

      <div class="neck" aria-hidden="true">
        <div class="neck__nut"></div>
        {[1, 2, 3, 4].map((f) => <span class="neck__fret" style={`--f:${f}`} />)}
        <span class="neck__inlay" style="--f:3"></span>
        {strings.map((_, i) => <span class="neck__str" style={`--s:${i}`} />)}
        {
          strings.map((_, i) => (
            <span class="neck__dot" data-dot={i} data-fret={first.frets[i]} style={`--s:${i};--f:${Math.max(first.frets[i], 0)}`} />
          ))
        }
      </div>

      <p class="fb__tab mono" data-tab aria-live="polite">
        {first.name}: {strings.map((s, i) => `${s} ${first.frets[i] < 0 ? "x" : first.frets[i]}`).join(" · ")}
      </p>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="plan-h">
    <div class="section__head">
      <div>
        <h2 id="plan-h">What the player will do</h2>
        <p>The plan, not a promise of dates.</p>
      </div>
    </div>
    <ul class="plan" role="list">
      <li class="card"><Icon name="play" /><strong>Follow along</strong><span>The current bar lights up as it plays.</span></li>
      <li class="card"><Icon name="clock" /><strong>Your tempo</strong><span>Slow it right down, then speed it back up.</span></li>
      <li class="card"><Icon name="restart" /><strong>Loop a bar</strong><span>Repeat the hard part until it sticks.</span></li>
    </ul>
  </section>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>("[data-chords]");
  if (root) {
    const chords: { id: string; frets: number[] }[] = JSON.parse(root.dataset.chords ?? "[]");
    const strings = ["E", "A", "D", "G", "B", "e"];
    const picks = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-chord]"));
    const dots = Array.from(root.querySelectorAll<HTMLElement>("[data-dot]"));
    const tab = root.querySelector<HTMLElement>("[data-tab]");
    const select = (btn: HTMLButtonElement, focus = false) => {
      const chord = chords.find((c) => c.id === btn.dataset.chord);
      if (!chord) return;
      for (const p of picks) {
        const on = p === btn;
        p.setAttribute("aria-checked", String(on));
        p.tabIndex = on ? 0 : -1;
      }
      if (focus) btn.focus();
      chord.frets.forEach((f, i) => {
        const dot = dots[i];
        dot.dataset.fret = String(f);
        dot.style.setProperty("--f", String(Math.max(f, 0)));
      });
      if (tab) {
        const label = btn.textContent?.trim() ?? "";
        tab.textContent = `${label}: ${strings.map((s, i) => `${s} ${chord.frets[i] < 0 ? "x" : chord.frets[i]}`).join(" · ")}`;
      }
    };
    picks.forEach((p, i) => {
      p.tabIndex = i === 0 ? 0 : -1;
      p.addEventListener("click", () => select(p));
      p.addEventListener("keydown", (e) => {
        const step = e.key === "ArrowRight" || e.key === "ArrowDown" ? 1 : e.key === "ArrowLeft" || e.key === "ArrowUp" ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        select(picks[(i + step + picks.length) % picks.length], true);
      });
    });
  }
</script>

<style>
  .fb {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .fb__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .fb__head h2 {
    font-size: 1.375rem;
    letter-spacing: -0.03em;
  }
  .fb__picks {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface-2);
  }
  .fb__pick {
    min-height: 2.25rem;
    padding: 0 0.875rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--text-2);
    font: 600 0.875rem var(--sans);
    cursor: pointer;
  }
  .fb__pick:hover {
    color: var(--text);
  }
  .fb__pick[aria-checked="true"] {
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 0 0 1px var(--hue-line);
  }

  /* The neck: nut on the left, four frets, six strings (low E at the bottom, as you look down at the guitar). */
  .neck {
    --pad: 1.25rem;
    position: relative;
    height: clamp(11rem, 26vw, 15rem);
    border-radius: var(--radius-s);
    background: color-mix(in oklab, var(--hue) 8%, var(--surface-2));
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .neck__nut {
    position: absolute;
    left: 6%;
    top: var(--pad);
    bottom: var(--pad);
    width: 6px;
    border-radius: 3px;
    background: var(--text-2);
  }
  .neck__fret {
    position: absolute;
    left: calc(6% + var(--f) * 22%);
    top: var(--pad);
    bottom: var(--pad);
    width: 2px;
    background: var(--line-2);
  }
  .neck__inlay {
    position: absolute;
    left: calc(6% + (var(--f) - 0.5) * 22%);
    top: 50%;
    width: 0.75rem;
    height: 0.75rem;
    margin: -0.375rem;
    border-radius: 50%;
    background: var(--line-2);
  }
  .neck__str {
    position: absolute;
    left: 6%;
    right: 2%;
    top: calc(var(--pad) + (5 - var(--s)) * (100% - 2 * var(--pad)) / 5);
    height: calc(1px + (5 - var(--s)) * 0.35px);
    background: color-mix(in oklab, var(--text) 55%, transparent);
  }
  .neck__dot {
    position: absolute;
    top: calc(var(--pad) + (5 - var(--s)) * (100% - 2 * var(--pad)) / 5);
    left: calc(6% + (var(--f) - 0.5) * 22%);
    width: clamp(1.25rem, 3.4vw, 1.75rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--hue);
    box-shadow: 0 4px 12px -4px rgb(0 0 0 / 0.5);
    transform: translate(-50%, -50%);
  }
  /* Open strings: a ring just left of the nut. Muted: a small cross. */
  .neck__dot[data-fret="0"] {
    left: 3%;
    width: 0.875rem;
    background: transparent;
    box-shadow: inset 0 0 0 2px var(--hue);
  }
  .neck__dot[data-fret="-1"] {
    left: 3%;
    width: 0.875rem;
    border-radius: 2px;
    background:
      linear-gradient(45deg, transparent 42%, var(--text-3) 42% 58%, transparent 58%),
      linear-gradient(-45deg, transparent 42%, var(--text-3) 42% 58%, transparent 58%);
    box-shadow: none;
  }
  :global(:root[data-motion="full"]) .neck__dot {
    transition:
      left 420ms var(--ease),
      width 220ms var(--ease),
      background-color 220ms var(--ease);
  }
  .fb__tab {
    color: var(--text-2);
    font-size: 0.875rem;
  }

  .plan {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .plan li {
    display: grid;
    gap: 0.375rem;
    padding: 1.25rem;
  }
  .plan li :global(.icon) {
    color: var(--hue);
  }
  .plan strong {
    margin-top: 0.375rem;
  }
  .plan span {
    color: var(--text-2);
    font-size: 0.9375rem;
  }
  @media (max-width: 48rem) {
    .plan {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
