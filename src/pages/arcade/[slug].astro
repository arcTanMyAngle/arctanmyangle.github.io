---
// One page per hosted game (src/data/play.ts). The game runs from origin G in a sandboxed frame, started on Play.
// stacker.astro and reaction.astro are static routes, so they win over this one.
import BaseLayout from "../../layouts/BaseLayout.astro";
import GameFrame from "../../components/GameFrame.astro";
import Icon from "../../components/Icon.astro";
import PlayPoster from "../../components/PlayPoster.astro";
import { hostedGames, playUrl, type HostedGame } from "../../data/play";
import { href } from "../../data/site";

export function getStaticPaths() {
  return hostedGames.map((game) => ({ params: { slug: game.slug }, props: { game } }));
}

const { game } = Astro.props as { game: HostedGame };
const url = playUrl(game.slug);
const host = new URL(url).host;
---

<BaseLayout title={game.title} section="arcade" description={game.blurb}>
  <GameFrame title={game.title} lede={game.blurb} back={{ label: "Arcade", path: "arcade" }}>
    <div class="card pf" data-play-frame data-src={url} data-title={game.title} data-state="idle">
      <div class="pf__stage" data-stage>
        <div class="pf__panel pf__poster" data-poster>
          <PlayPoster slug={game.slug} />
          <button type="button" class="btn btn--primary" data-play disabled>
            <Icon name="play" size={18} /> Play {game.title}
          </button>
          <p class="pf__hint muted">Needs JavaScript. Loads from {host} when you press Play.</p>
        </div>
        <div class="pf__panel" data-loading hidden>
          <p class="pf__status">Loading…</p>
        </div>
        <div class="pf__panel" data-fail hidden>
          <p class="pf__status">Couldn't start.</p>
          <div class="actions">
            <button type="button" class="btn btn--primary" data-retry><Icon name="restart" size={18} /> Retry</button>
            <a class="btn" href={url} target="_blank" rel="noopener noreferrer">
              Open in new tab <Icon name="external" size={16} />
            </a>
            <a class="btn btn--quiet" href={href("arcade")}>Back to arcade</a>
          </div>
        </div>
      </div>
      <div class="pf__bar">
        <button type="button" class="btn btn--small" data-fullscreen aria-pressed="false" hidden>
          <span data-fs-label>Fullscreen</span>
        </button>
        <a class="btn btn--small btn--quiet" href={url} target="_blank" rel="noopener noreferrer">
          Open in new tab <Icon name="external" size={14} />
        </a>
        <button type="button" class="btn btn--small btn--quiet pf__exit" data-exit hidden>
          <Icon name="close" size={14} /> Exit
        </button>
      </div>
      <p class="sr-only" aria-live="polite" data-live></p>
    </div>

    <Fragment slot="side">
      <section class="panel" aria-labelledby="pf-howto">
        <h2 id="pf-howto">How to play</h2>
        <ul class="howto" role="list">
          {game.howto.map((h) => (
            <li><span class="kbd">{h.key}</span> {h.text}</li>
          ))}
        </ul>
        {game.phoneNote && <p class="muted pf__fine">{game.phoneNote}</p>}
      </section>
      <section class="panel" aria-labelledby="pf-credits">
        <h2 id="pf-credits">Credits</h2>
        <p class="pf__fine">
          {game.title} is by {game.credit}, released under the {game.license} licence. This copy has ads, analytics
          and calls to other servers removed; nothing about the game itself changes.
        </p>
        <p class="pf__fine">
          <a href={game.source} rel="noopener noreferrer">Source code on GitHub <Icon name="external" size={14} /></a>
          <br />
          <a href={`${url}CHANGES.md`} rel="noopener noreferrer">What we changed <Icon name="external" size={14} /></a>
        </p>
      </section>
    </Fragment>
  </GameFrame>
</BaseLayout>

<script>
  import { mount } from "../../components/playFrame";
  import { PLAY_ORIGIN } from "../../data/play";
  const root = document.querySelector<HTMLElement>("[data-play-frame]");
  if (root) mount(root, { origin: PLAY_ORIGIN });
</script>

<style>
  .pf {
    display: grid;
  }
  .pf__stage {
    position: relative;
    display: grid;
    height: clamp(30rem, 78svh, 48rem);
    background:
      radial-gradient(30rem 16rem at 50% 100%, var(--hue-soft), transparent 70%),
      var(--surface-2);
  }
  .pf__stage:fullscreen {
    height: 100%;
    background: var(--bg, #000);
  }
  /* Pseudo fullscreen (playFrame.ts): the frame and its bar cover the screen where the Fullscreen API is missing. */
  .pf[data-pseudo-fs] {
    position: fixed;
    inset: 0;
    z-index: 1000;
    grid-template-rows: 1fr auto;
    height: 100dvh;
    border: 0;
    border-radius: 0;
    background: var(--bg, #000);
  }
  .pf[data-pseudo-fs] .pf__stage {
    height: auto;
    min-height: 0;
  }
  .pf[data-pseudo-fs] .pf__bar {
    padding-bottom: max(0.75rem, env(safe-area-inset-bottom));
  }
  :global(html.pf-locked),
  :global(html.pf-locked body) {
    overflow: hidden;
  }
  /* main is its own stacking context (global.css), so lift it over the header and footer; the palette (200) stays on top. */
  :global(html.pf-locked main) {
    z-index: 150;
  }
  .pf__panel {
    display: grid;
    gap: 1.25rem;
    place-content: center;
    justify-items: center;
    padding: 1.5rem;
    text-align: center;
  }
  .pf__status {
    font-size: 1.25rem;
    font-weight: 650;
  }
  .pf__hint,
  .pf__fine {
    max-width: 40ch;
    font-size: 0.875rem;
  }
  .pf__fine + .pf__fine {
    margin-top: 0.5rem;
  }
  .pf__fine a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }
  .pf :global(.pf__frame) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: #fff;
  }
  /* Keep the frame hidden until the game says it's ready, so a half-loaded page never shows. */
  .pf[data-state="loading"] :global(.pf__frame) {
    position: absolute;
    inset: 0;
    visibility: hidden;
  }
  .pf__bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    padding: 0.75rem;
    border-top: 1px solid var(--line);
  }
  .pf__exit {
    margin-left: auto;
  }

</style>
