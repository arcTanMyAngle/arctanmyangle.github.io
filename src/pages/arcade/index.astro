---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import StackerPreview from "../../components/StackerPreview.astro";
import PlayPoster from "../../components/PlayPoster.astro";
import { games, href } from "../../data/site";
import { hostedGames, linkedGames } from "../../data/play";

const stacker = games.find((g) => g.slug === "stacker")!;
const reaction = games.find((g) => g.slug === "reaction")!;
const canvasGames = games.filter((g) => g.slug !== "stacker" && g.slug !== "reaction");
---

<BaseLayout title="Arcade" section="arcade" description="Small games that play right in the browser, on a keyboard or a phone.">
  <header class="wrap page-head">
    <span class="eyebrow">Arcade</span>
    <h1>Quick games, fair rules.</h1>
    <p class="lede">
      Each one loads instantly, plays with a keyboard or a phone, and keeps your progress on this device. No accounts,
      and no ads on anything hosted here.
    </p>
  </header>

  <section class="wrap games" aria-label="Games">
    <article class="card game card--lift" data-spotlight>
      <div class="game__art game__art--stacker">
        <StackerPreview />
      </div>
      <div class="game__body">
        <div class="game__meta">
          <span class="badge">Playable</span>
          <span class="kbd">{stacker.controls}</span>
        </div>
        <h2><a class="card__link" href={href(`arcade/${stacker.slug}`)}>{stacker.title}</a></h2>
        <p>{stacker.blurb}</p>
        <span class="game__cta" aria-hidden="true">Play <Icon name="arrow" size={16} /></span>
      </div>
    </article>

    <article class="card game card--lift" data-spotlight>
      <div class="game__art game__art--reaction" aria-hidden="true">
        <div class="rxmini">
          <span class="rxmini__wait">Wait…</span>
          <span class="rxmini__go">Go!</span>
        </div>
      </div>
      <div class="game__body">
        <div class="game__meta">
          <span class="badge">Playable</span>
          <span class="kbd">{reaction.controls}</span>
        </div>
        <h2><a class="card__link" href={href(`arcade/${reaction.slug}`)}>{reaction.title}</a></h2>
        <p>{reaction.blurb}</p>
        <span class="game__cta" aria-hidden="true">Play <Icon name="arrow" size={16} /></span>
      </div>
    </article>

    {canvasGames.map((g) => (
      <article class="card game card--lift" data-spotlight>
        <div class:list={["game__art", `game__art--${g.slug}`]} aria-hidden="true">
          {g.slug === "iron-line" && (
            <div class="ilmini">
              <span class="ilmini__ridge" />
              <span class="ilmini__reticle" />
            </div>
          )}
          {g.slug === "monolith" && (
            <div class="mnmini">
              <span class="mnmini__stone" />
              <span class="mnmini__floor" />
            </div>
          )}
          {g.slug === "lane-rush" && (
            <div class="lrmini"><span /><span /><span /><i /></div>
          )}
        </div>
        <div class="game__body">
          <div class="game__meta">
            <span class="badge">Playable</span>
            <span class="kbd">{g.controls}</span>
          </div>
          <h2><a class="card__link" href={href(`arcade/${g.slug}`)}>{g.title}</a></h2>
          <p>{g.blurb}</p>
          <span class="game__cta" aria-hidden="true">Play <Icon name="arrow" size={16} /></span>
        </div>
      </article>
    ))}

    {hostedGames.map((g) => (
      <article class="card game card--lift" data-spotlight>
        <div class="game__art">
          <PlayPoster slug={g.slug} />
        </div>
        <div class="game__body">
          <div class="game__meta">
            <span class="badge">Playable</span>
            <span class="kbd">{g.controls}</span>
          </div>
          <h2><a class="card__link" href={href(`arcade/${g.slug}`)}>{g.title}</a></h2>
          <p>{g.blurb}</p>
          <span class="game__cta" aria-hidden="true">Play <Icon name="arrow" size={16} /></span>
        </div>
      </article>
    ))}

    {linkedGames.map((g) => (
      <article class="card game game--linked card--lift" data-spotlight>
        <div class="game__art game__art--linked" aria-hidden="true">
          <div class="rails"><span /><span /><span /></div>
        </div>
        <div class="game__body">
          <div class="game__meta">
            <span class="badge badge--muted">On {g.host}</span>
            <span class="kbd">{g.controls}</span>
          </div>
          <h2>
            <a class="card__link" href={g.url} target="_blank" rel="noopener noreferrer">
              {g.title}<span class="sr-only"> (opens {g.host} in a new tab)</span>
            </a>
          </h2>
          <p>{g.blurb}</p>
          <span class="game__cta" aria-hidden="true">Opens in new tab ↗</span>
        </div>
      </article>
    ))}

    <article class="card game game--wide card--lift" data-hue="chess" data-spotlight>
      <div class="game__body">
        <div class="game__meta">
          <span class="badge">vs computer · 2P</span>
          <span class="kbd">Click · drag · keys</span>
        </div>
        <h2><a class="card__link" href={href("chess/play")}>Chess</a></h2>
        <p>Play the computer on easy, medium or hard, or pass and play with a friend. Clocks, undo and a move list, and the game is saved if you close the tab.</p>
        <span class="game__cta" aria-hidden="true">Sit down <Icon name="arrow" size={16} /></span>
      </div>
      <div class="game__art game__art--chess" aria-hidden="true">
        {Array.from({ length: 16 }, (_, i) => <span class:list={["mini-sq", (Math.floor(i / 4) + i) % 2 ? "is-dark" : ""]} />)}
      </div>
    </article>
  </section>

  <section class="wrap section">
    <p class="note">
      <Icon name="play" size={18} />
      <span>
        Also here: a flatground <a href={href("skate")}>skate sim</a> whose tricks are learned, not scripted. Try them yourself.
      </span>
    </p>
  </section>
</BaseLayout>

<style>
  .games {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .game {
    display: flex;
    flex-direction: column;
  }
  .game > * {
    position: relative;
    z-index: 1;
  }
  .game__art {
    display: grid;
    place-items: center;
    min-height: 16rem;
    padding: 1.5rem;
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(26rem 14rem at 50% 100%, var(--hue-soft), transparent 70%),
      var(--surface-2);
  }
  .game__art--stacker :global(.stackmini) {
    margin-top: 0;
  }
  .game__body {
    display: grid;
    gap: 0.625rem;
    align-content: start;
    padding: 1.5rem;
  }
  .game__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }
  .game__meta .kbd {
    color: var(--text-2);
    font-size: 0.75rem;
  }
  .game h2 {
    font-size: 1.5rem;
    letter-spacing: -0.03em;
  }
  .game p {
    max-width: 46ch;
    color: var(--text-2);
  }
  .game__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.5rem;
    color: var(--hue);
    font-size: 0.9375rem;
    font-weight: 600;
  }
  :global(:root[data-motion="full"]) .game:hover .game__cta :global(.icon) {
    transform: translateX(3px);
    transition: transform 200ms var(--ease);
  }

  /* Reaction preview: the pad flips between "wait" and "go". Static "Go!" under reduced motion. */
  .rxmini {
    position: relative;
    display: grid;
    place-items: center;
    width: min(100%, 17rem);
    aspect-ratio: 16 / 10;
    border-radius: var(--radius);
    background: #15803d;
    color: #fff;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    box-shadow: 0 18px 40px -24px rgb(0 0 0 / 0.6);
  }
  .rxmini > span {
    grid-area: 1 / 1;
  }
  .rxmini__wait {
    visibility: hidden;
  }
  :global(:root[data-motion="full"]) .rxmini {
    animation: rx-pad 3.6s steps(1, end) infinite;
  }
  :global(:root[data-motion="full"]) .rxmini__wait {
    animation: rx-wait 3.6s steps(1, end) infinite;
  }
  :global(:root[data-motion="full"]) .rxmini__go {
    animation: rx-go 3.6s steps(1, end) infinite;
  }
  @keyframes rx-pad {
    0% {
      background: #b42318;
    }
    68% {
      background: #15803d;
    }
  }
  @keyframes rx-wait {
    0% {
      visibility: visible;
    }
    68% {
      visibility: hidden;
    }
  }
  @keyframes rx-go {
    0% {
      visibility: hidden;
    }
    68% {
      visibility: visible;
    }
  }

  /* Canvas game previews: plain shapes, nothing animated. */
  .ilmini,
  .mnmini {
    position: relative;
    width: min(100%, 17rem);
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius);
    box-shadow: 0 18px 40px -24px rgb(0 0 0 / 0.6);
  }
  .ilmini {
    background: linear-gradient(#f2a65a 0 46%, #3a3f46 46% 100%);
  }
  .ilmini__ridge {
    position: absolute;
    inset: 22% 0 54%;
    background: #6b5a4e;
    clip-path: polygon(0 100%, 0 55%, 14% 30%, 28% 60%, 46% 20%, 63% 55%, 80% 25%, 100% 60%, 100% 100%);
  }
  .ilmini__reticle {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 2.75rem;
    height: 2.75rem;
    translate: -50% -50%;
    border: 2px solid #f4f4f6;
    border-radius: 50%;
    background:
      linear-gradient(#f4f4f6, #f4f4f6) center / 2px 60% no-repeat,
      linear-gradient(#f4f4f6, #f4f4f6) center / 60% 2px no-repeat;
  }
  .mnmini {
    background: linear-gradient(#1b1430, #3a2350);
  }
  .mnmini__stone {
    position: absolute;
    left: 50%;
    top: 12%;
    width: 2.6rem;
    height: 58%;
    translate: -50% 0;
    background: linear-gradient(90deg, #4a4658, #8a849c 55%, #5c5770);
    clip-path: polygon(50% 0, 100% 14%, 86% 100%, 14% 100%, 0 14%);
    box-shadow: 0 0 30px var(--hue);
  }
  .mnmini__floor {
    position: absolute;
    inset: 82% 0 0;
    background: #120d1f;
    border-top: 2px solid var(--hue);
  }
  .lrmini {
    position: relative;
    display: flex;
    gap: 1rem;
    height: 11rem;
    transform: perspective(14rem) rotateX(38deg);
  }
  .lrmini span {
    width: 2.5rem;
    border-inline: 2px solid var(--hue);
    background: repeating-linear-gradient(to bottom, transparent 0 1rem, var(--hue-soft) 1rem 1.25rem);
  }
  .lrmini i {
    position: absolute;
    left: 50%;
    bottom: 0.5rem;
    width: 1.75rem;
    height: 0.5rem;
    translate: -50% 0;
    border-radius: 999px;
    background: var(--hue);
  }

  /* Linked-out card: three tracks in perspective, no third-party art. */
  .rails {
    display: flex;
    gap: 1.25rem;
    height: 11rem;
    transform: perspective(14rem) rotateX(38deg);
  }
  .rails span {
    width: 2.25rem;
    border-inline: 3px solid var(--text-2);
    background: repeating-linear-gradient(to bottom, transparent 0 0.875rem, var(--line) 0.875rem 1.125rem);
  }

  /* Chess-for-two card: horizontal on wide screens. */
  .game--wide {
    grid-column: 1 / -1;
    flex-direction: row;
    align-items: stretch;
  }
  .game--wide .game__body {
    flex: 1;
    align-content: center;
  }
  .game__art--chess {
    display: grid;
    grid-template-columns: repeat(4, 2.75rem);
    grid-auto-rows: 2.75rem;
    gap: 0;
    place-content: center;
    min-height: 0;
    min-width: 18rem;
    border-bottom: 0;
    border-left: 1px solid var(--line);
  }
  .mini-sq {
    background: var(--board-light);
  }
  .mini-sq.is-dark {
    background: var(--board-dark);
  }
  .mini-sq:first-child {
    border-top-left-radius: 8px;
  }
  .mini-sq:nth-child(4) {
    border-top-right-radius: 8px;
  }
  .mini-sq:nth-child(13) {
    border-bottom-left-radius: 8px;
  }
  .mini-sq:last-child {
    border-bottom-right-radius: 8px;
  }

  @media (max-width: 48rem) {
    .games {
      grid-template-columns: minmax(0, 1fr);
    }
    .game--wide {
      flex-direction: column-reverse;
    }
    .game__art--chess {
      min-width: 0;
      padding-block: 1.5rem;
      border-left: 0;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
