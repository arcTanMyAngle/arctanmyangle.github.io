---
// CSS-only poster for a hosted game (src/data/play.ts): shown on the arcade card and before Play, so no game bytes
// load until someone asks for them.
interface Props {
  slug: string;
}
const { slug } = Astro.props;
const tiles = ["2", "4", "8", "16", "32", "64", "128", "2048", "", "2", "", "4", "8", "", "2", ""];
---

<div class:list={["pp", `pp--${slug}`]} aria-hidden="true">
  {slug === "2048" && (
    <div class="t48">
      {tiles.map((n) => <span data-n={n}>{n}</span>)}
    </div>
  )}
  {slug === "hextris" && <div class="hexmini"><span /></div>}
  {slug === "a-dark-room" && (
    <p class="adrmini">
      <span>the room is freezing.</span>
      <span class="adrmini__btn">light fire</span>
    </p>
  )}
  {slug === "clumsy-bird" && (
    <div class="birdmini">
      <span class="birdmini__pipe birdmini__pipe--top" />
      <span class="birdmini__bird" />
      <span class="birdmini__pipe birdmini__pipe--bottom" />
    </div>
  )}
  {slug === "tower-blocks" && (
    <div class="towermini">
      <span class="towermini__rope" />
      {[0, 1, 2, 3].map((i) => <span class="towermini__block" style={`--i:${i}`} />)}
    </div>
  )}
</div>

<style>
  .t48 {
    display: grid;
    grid-template-columns: repeat(4, 3rem);
    gap: 0.375rem;
    padding: 0.375rem;
    border-radius: var(--radius-s);
    background: #bbada0;
  }
  .t48 span {
    display: grid;
    place-items: center;
    height: 3rem;
    border-radius: 4px;
    background: rgb(238 228 218 / 0.35);
    color: #776e65;
    font: 700 0.9375rem/1 var(--mono);
  }
  .t48 [data-n="2"],
  .t48 [data-n="4"] {
    background: #eee4da;
  }
  .t48 [data-n="8"],
  .t48 [data-n="16"] {
    background: #f2b179;
    color: #f9f6f2;
  }
  .t48 [data-n="32"],
  .t48 [data-n="64"] {
    background: #f67c5f;
    color: #f9f6f2;
  }
  .t48 [data-n="128"],
  .t48 [data-n="2048"] {
    background: #edc22e;
    color: #f9f6f2;
    font-size: 0.75rem;
  }
  .hexmini {
    display: grid;
    place-items: center;
    width: 9rem;
    aspect-ratio: 1;
  }
  .hexmini span {
    width: 6rem;
    aspect-ratio: 1 / 1.1547;
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    background: conic-gradient(
      #e74c3c 0 60deg,
      #f1c40f 0 120deg,
      #3498db 0 180deg,
      #2ecc71 0 240deg,
      #e74c3c 0 300deg,
      #3498db 0
    );
  }
  :global(:root[data-motion="full"]) .hexmini span {
    animation: hex-spin 6s steps(6, end) infinite;
  }
  @keyframes hex-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .adrmini {
    display: grid;
    gap: 1rem;
    justify-items: center;
    color: var(--text);
    font: 1rem/1.4 Georgia, "Times New Roman", serif;
  }
  .adrmini__btn {
    padding: 0.25rem 1.25rem;
    border: 1px solid currentColor;
  }
  .birdmini {
    position: relative;
    width: 9rem;
    height: 9rem;
    border-radius: var(--radius-s);
    overflow: hidden;
    background: #70c5ce;
  }
  .birdmini__pipe {
    position: absolute;
    right: 1.5rem;
    width: 2.25rem;
    border: 2px solid #3e6b1f;
    background: #73bf2e;
  }
  .birdmini__pipe--top {
    top: -2px;
    height: 2.75rem;
  }
  .birdmini__pipe--bottom {
    bottom: -2px;
    height: 3rem;
  }
  .birdmini__bird {
    position: absolute;
    top: 3.75rem;
    left: 2rem;
    width: 1.5rem;
    height: 1.125rem;
    border: 2px solid #543847;
    border-radius: 50%;
    background: #f8c537;
  }
  :global(:root[data-motion="full"]) .birdmini__bird {
    animation: bird-flap 0.9s ease-in-out infinite alternate;
  }
  @keyframes bird-flap {
    to {
      transform: translateY(-0.75rem) rotate(-12deg);
    }
  }
  .towermini {
    display: grid;
    justify-items: center;
    align-content: end;
    width: 9rem;
    height: 9rem;
  }
  .towermini__rope {
    width: 2px;
    height: 1.5rem;
    background: var(--text-3);
  }
  .towermini__block {
    width: 3.5rem;
    height: 1.25rem;
    margin-left: calc((var(--i) - 1.5) * 0.375rem);
    border: 2px solid #8a5a2b;
    background: #e9b872;
  }
  .towermini__rope + .towermini__block {
    margin-bottom: 0.75rem;
  }
</style>
