---
interface Props {
  variant?: "compact" | "full";
  githubUrl?: string;
}

const { variant = "compact", githubUrl } = Astro.props;

const GAMES = [
  { name: "Wii Kart", blurb: "3D procedural kart racer — Rust + macroquad, fixed 60Hz sim." },
  { name: "Uncanny Carnival", blurb: "Six skill games, five difficulty tiers — Three.js, zero RNG rigging." },
  { name: "Galaga", blurb: "Built twice — once in C++, once in Rust — as a direct language comparison." },
  { name: "HTML Cabinet", blurb: "Five zero-dependency single-file browser games." },
];
---

<div class={`arcade-cabinet arcade-cabinet--${variant} pixel-border`} data-state="insert-coin" data-selected="0">
  <div class="arcade-cabinet__screen">
    <div class="arcade-cabinet__panel" data-panel="insert-coin">
      <p class="arcade-cabinet__blink">INSERT COIN</p>
      <p class="arcade-cabinet__hint">to select a cabinet</p>
    </div>
    <div class="arcade-cabinet__panel" data-panel="select" hidden>
      <ul class="arcade-cabinet__games">
        {GAMES.map((g, i) => (
          <li class="arcade-cabinet__game" data-index={i} aria-selected={i === 0 ? "true" : "false"}>
            <strong>{g.name}</strong>
            <span>{g.blurb}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="arcade-cabinet__panel" data-panel="loaded" hidden>
      <p class="arcade-cabinet__loaded-name" data-loaded-name></p>
      <p class="arcade-cabinet__hint">good luck.</p>
    </div>
  </div>

  <div class="arcade-cabinet__controls">
    <button type="button" class="beveled-button beveled-button--primary" data-action="coin">Insert Coin</button>
    <button type="button" class="beveled-button" data-action="up" hidden>▲</button>
    <button type="button" class="beveled-button" data-action="down" hidden>▼</button>
    <button type="button" class="beveled-button beveled-button--cyan" data-action="start" hidden>Start</button>
    {
      githubUrl && (
        <a class="beveled-button beveled-button--magenta" href={githubUrl} target="_blank" rel="noopener noreferrer">
          View source
        </a>
      )
    }
  </div>

  {
    variant === "full" && (
      <p class="arcade-cabinet__keys">Keyboard: Enter to insert coin / start · Arrow Up/Down to pick a cabinet</p>
    )
  }
</div>

<style>
  .arcade-cabinet {
    background: var(--color-bg-inset);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .arcade-cabinet__screen {
    background: #010203;
    border: 1px solid var(--color-border-bright);
    min-height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
  }
  .arcade-cabinet--full .arcade-cabinet__screen {
    min-height: 240px;
  }
  .arcade-cabinet__panel {
    width: 100%;
    text-align: center;
    color: var(--color-green);
  }
  .arcade-cabinet__blink {
    font-size: var(--text-lg);
    letter-spacing: 0.1em;
    text-shadow: var(--glow-green);
  }
  :root[data-motion="full"] .arcade-cabinet__blink {
    animation: status-blink 1s steps(2, jump-none) infinite;
  }
  .arcade-cabinet__hint {
    color: var(--color-text-dim);
    font-size: var(--text-sm);
    margin-top: var(--space-2);
  }
  .arcade-cabinet__games {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    text-align: left;
  }
  .arcade-cabinet__game {
    display: flex;
    flex-direction: column;
    padding: var(--space-2) var(--space-3);
    border: 1px solid transparent;
    color: var(--color-text-dim);
    font-size: var(--text-sm);
  }
  .arcade-cabinet__game strong {
    color: var(--color-text);
  }
  .arcade-cabinet__game[aria-selected="true"] {
    border-color: var(--color-cyan);
    color: var(--color-cyan);
  }
  .arcade-cabinet__game[aria-selected="true"] strong {
    color: var(--color-cyan);
  }
  .arcade-cabinet__loaded-name {
    font-size: var(--text-lg);
    color: var(--color-amber);
    text-shadow: var(--glow-amber);
  }
  .arcade-cabinet__controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .arcade-cabinet__keys {
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }
</style>

<script>
  function initCabinets() {
    document.querySelectorAll<HTMLElement>(".arcade-cabinet").forEach((cabinet) => {
      if (cabinet.dataset.wired === "true") return;
      cabinet.dataset.wired = "true";

      const panels = {
        "insert-coin": cabinet.querySelector<HTMLElement>('[data-panel="insert-coin"]')!,
        select: cabinet.querySelector<HTMLElement>('[data-panel="select"]')!,
        loaded: cabinet.querySelector<HTMLElement>('[data-panel="loaded"]')!,
      };
      const games = Array.from(cabinet.querySelectorAll<HTMLElement>(".arcade-cabinet__game"));
      const loadedName = cabinet.querySelector<HTMLElement>("[data-loaded-name]")!;
      const buttons = {
        coin: cabinet.querySelector<HTMLButtonElement>('[data-action="coin"]')!,
        up: cabinet.querySelector<HTMLButtonElement>('[data-action="up"]')!,
        down: cabinet.querySelector<HTMLButtonElement>('[data-action="down"]')!,
        start: cabinet.querySelector<HTMLButtonElement>('[data-action="start"]')!,
      };

      let selected = 0;

      function showPanel(name: "insert-coin" | "select" | "loaded") {
        cabinet.dataset.state = name;
        for (const [key, el] of Object.entries(panels)) el.hidden = key !== name;
        buttons.coin.hidden = name !== "insert-coin";
        buttons.up.hidden = name !== "select";
        buttons.down.hidden = name !== "select";
        buttons.start.hidden = name !== "select";
      }

      function renderSelection() {
        games.forEach((g, i) => g.setAttribute("aria-selected", String(i === selected)));
      }

      buttons.coin.addEventListener("click", () => showPanel("select"));
      buttons.up.addEventListener("click", () => {
        selected = (selected - 1 + games.length) % games.length;
        renderSelection();
      });
      buttons.down.addEventListener("click", () => {
        selected = (selected + 1) % games.length;
        renderSelection();
      });
      buttons.start.addEventListener("click", () => {
        loadedName.textContent = `Loading ${games[selected]?.querySelector("strong")?.textContent}...`;
        showPanel("loaded");
      });

      cabinet.addEventListener("keydown", (e) => {
        const key = (e as KeyboardEvent).key;
        if (cabinet.dataset.state === "insert-coin" && key === "Enter") {
          showPanel("select");
        } else if (cabinet.dataset.state === "select") {
          if (key === "ArrowUp") {
            selected = (selected - 1 + games.length) % games.length;
            renderSelection();
          } else if (key === "ArrowDown") {
            selected = (selected + 1) % games.length;
            renderSelection();
          } else if (key === "Enter") {
            buttons.start.click();
          }
        }
      });
      cabinet.tabIndex = 0;
    });
  }
  initCabinets();
  document.addEventListener("astro:page-load", initCabinets);
</script>
