---
const navLinks = [
  { href: "/projects/", label: "Projects" },
  { href: "/lab/", label: "Lab" },
  { href: "/arcade/", label: "Arcade" },
  { href: "/field-notes/", label: "Field Notes" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
];

const path = Astro.url.pathname;
function isCurrent(href: string) {
  if (href === "/") return path === "/";
  return path.startsWith(href);
}
---

<header class="site-header">
  <div class="shell site-header__bar">
    <a class="site-logo" href="/">
      <span class="status-dot status-dot--on status-dot--blink" aria-hidden="true"></span>
      arcTanMyAngle <span class="site-logo__tag">// signal deck</span>
    </a>

    <button class="beveled-button site-nav__toggle" id="nav-toggle" aria-expanded="false" aria-controls="site-nav">
      <span aria-hidden="true">≡</span>
      <span class="visually-hidden">Toggle navigation</span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Main">
      {
        navLinks.map((link) => (
          <a class="site-nav__link" href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
            {link.label}
          </a>
        ))
      }
      <button
        class="beveled-button beveled-button--ghost beveled-button--sm site-nav__palette-btn"
        id="palette-trigger"
        type="button"
        aria-haspopup="dialog"
      >
        <span aria-hidden="true">⌘K</span>
        <span class="visually-hidden">Open command palette</span>
      </button>
    </nav>
  </div>
</header>

<style>
  .site-logo__tag {
    color: var(--color-text-dim);
    font-weight: 400;
    font-size: var(--text-xs);
  }
  .site-nav__palette-btn {
    font-size: var(--text-xs);
    padding: var(--space-1) var(--space-2);
  }
  @media (max-width: 720px) {
    .site-logo__tag {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById("nav-toggle");
  const nav = document.getElementById("site-nav");
  toggle?.addEventListener("click", () => {
    const open = nav?.dataset.open === "true";
    nav?.setAttribute("data-open", String(!open));
    toggle.setAttribute("aria-expanded", String(!open));
  });
</script>
