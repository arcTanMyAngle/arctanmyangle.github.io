---
import type { Project } from "../lib/projects";
import ProjectCard from "./ProjectCard.astro";

interface Props {
  projects: Project[];
  id?: string;
  /** Stagger the cards in on scroll. Set on the grid itself so the cards are the
      animated children, not the wrapper. */
  reveal?: boolean;
}

const { projects, id, reveal = false } = Astro.props;
---

<div class="project-grid" id={id} data-reveal-group={reveal ? "" : undefined}>
  {projects.map((project) => <ProjectCard project={project} />)}
</div>
<div class="project-grid__empty" id={id ? `${id}-empty` : undefined} hidden>
  <p>No repositories match those filters.</p>
  <button type="button" class="beveled-button beveled-button--sm" data-filter-reset>Clear filters</button>
</div>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-5);
  }
  .project-grid__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text-dim);
    padding-block: var(--space-7);
    text-align: center;
  }
  .project-grid__empty[hidden] {
    display: none;
  }
</style>
