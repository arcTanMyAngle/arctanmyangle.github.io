{
  "ci": {
    "collect": {
      "startServerCommand": "bun scripts/serve-dist.mjs --port 4360",
      "startServerReadyPattern": "serve-dist\\] http",
      "url": [
        "http://localhost:4360/",
        "http://localhost:4360/arcade/",
        "http://localhost:4360/arcade/stacker/",
        "http://localhost:4360/chess/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["warn", { "minScore": 0.95, "aggregationMethod": "median-run" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
